---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Badge from '@/components/ui/Badge.astro';
import Button from '@/components/ui/Button.astro';
import ArchitecturalFrame from '@/components/ui/ArchitecturalFrame.astro';
import ResponsivePicture from '@/components/ui/ResponsivePicture.astro';
import { SECTORS } from '@/data/companyData';

interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
}

const {
  eyebrow = 'Core Industry Capabilities',
  title = 'Sectors & Business Operations',
  subtitle = 'Targeted multidisciplinary solutions designed to solve critical operational, structural, and procurement challenges across three core sectors.'
} = Astro.props;
---

<section id="sectors" class="py-20 lg:py-24 bg-blueprint-bg border-b border-slate-200" aria-labelledby="sectors-title">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <SectionHeading
      index="01"
      eyebrow={eyebrow}
      title={title}
      subtitle={subtitle}
    />

    <!-- 3 Sector Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {SECTORS.map((sector, index) => (
        <article class="flex flex-col bg-white border border-slate-300 hover:border-navy-900 transition-colors duration-200 group">
          
          <!-- Image Header with Architectural Cut -->
          <div class="relative overflow-hidden border-b border-slate-300 bg-navy-950">
            <div class="aspect-[16/10] w-full overflow-hidden">
              <ResponsivePicture
                desktopSrc={sector.imageDesktop}
                mobileSrc={sector.imageMobile}
                alt={sector.title}
                width={1200}
                height={750}
                loading="lazy"
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
            </div>

            <!-- Top Left Index Badge -->
            <div class="absolute top-3 left-3">
              <span class="px-2 py-0.5 bg-navy-950 text-white font-mono text-[10px] font-bold uppercase tracking-wider border border-white/20">
                SEC 0{index + 1}
              </span>
            </div>

            <!-- Lead Entity Attribution Tag -->
            <div class="absolute bottom-3 right-3">
              <Badge variant="navy" size="sm">
                {sector.leadEntity}
              </Badge>
            </div>
          </div>

          <!-- Content Body -->
          <div class="p-6 sm:p-7 flex-1 flex flex-col justify-between">
            <div>
              <h3 class="text-lg sm:text-xl font-display font-bold uppercase tracking-tight text-navy-900 group-hover:text-steel-600 transition-colors">
                {sector.title}
              </h3>
              
              <p class="mt-3 text-xs sm:text-sm text-slate-600 font-sans leading-relaxed">
                {sector.summary}
              </p>

              <!-- Capability Bullet Points -->
              <div class="mt-5 pt-5 border-t border-slate-200">
                <div class="text-[10px] font-mono uppercase text-slate-500 tracking-wider mb-2.5">
                  Core Scope &amp; Offerings:
                </div>
                <ul class="space-y-2 text-xs text-slate-700" role="list">
                  {sector.bulletPoints.map((bullet) => (
                    <li class="flex items-start gap-2">
                      <span class="text-steel-500 font-mono text-sm leading-none mt-0.5 select-none" aria-hidden="true">■</span>
                      <span>{bullet}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <!-- Key Stats & Footer Link -->
            <div class="mt-6 pt-5 border-t border-slate-200">
              <div class="grid grid-cols-2 gap-2 mb-4 font-mono">
                {sector.stats.map((stat) => (
                  <div class="p-2 bg-slate-50 border border-slate-200 text-center">
                    <span class="block text-[10px] text-slate-500 uppercase">{stat.label}</span>
                    <span class="block text-xs font-bold text-navy-900">{stat.value}</span>
                  </div>
                ))}
              </div>

              <a
                href={`/sectors#${sector.id}`}
                class="inline-flex items-center justify-between w-full py-2.5 px-3 bg-slate-100 hover:bg-navy-900 text-navy-900 hover:text-white font-display text-xs font-semibold uppercase tracking-wider transition-colors duration-150 border border-slate-300 hover:border-navy-900"
              >
                <span>Explore {sector.title.split(' ')[0]} Scope</span>
                <span aria-hidden="true">→</span>
              </a>
            </div>

          </div>
        </article>
      ))}
    </div>

  </div>
</section>
