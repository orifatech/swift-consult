---
import Button from '@/components/ui/Button.astro';
import Badge from '@/components/ui/Badge.astro';
---

<section class="py-16 sm:py-20 bg-navy-950 text-white border-b border-navy-800 relative overflow-hidden" aria-labelledby="unified-entities-title">
  <!-- Architectural Diagonal Line Accent -->
  <div class="absolute -right-20 -bottom-20 w-80 h-80 border border-steel-500/10 pointer-events-none rotate-12" aria-hidden="true"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      
      <!-- Left Column: Unified Statement -->
      <div class="lg:col-span-8 space-y-4">
        <div class="flex items-center gap-2">
          <Badge variant="gold">Corporate Structure &amp; Synergy</Badge>
          <span class="font-mono text-xs text-slate-400 uppercase tracking-wider">// Dual-Entity Model</span>
        </div>

        <h2 id="unified-entities-title" class="text-2xl sm:text-3xl lg:text-4xl font-display font-bold uppercase tracking-tight text-white leading-tight">
          Two Specialized Powerhouses. One Seamless EPC Delivery Model.
        </h2>

        <p class="text-sm sm:text-base text-slate-300 font-sans leading-relaxed max-w-3xl">
          Swift Consult Inc. and Swift Global Inc. are coordinated sister organizations designed to eliminate the friction between engineering design, regulatory compliance, and cross-border construction execution. Whether you engage us for municipal approvals in Ontario or heavy industrial procurement across the Atlantic, you receive the full backing of our unified technical engine.
        </p>

        <!-- Side-by-Side Comparison Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4">
          <!-- Consult Entity Box -->
          <div class="p-4 bg-navy-900 border-l-2 border-steel-400 border-t border-r border-b border-navy-800">
            <div class="flex items-center justify-between mb-2">
              <span class="font-display font-bold text-white text-sm uppercase">Swift Consult Inc.</span>
              <span class="font-mono text-[10px] text-steel-400">swiftconsultinc.com</span>
            </div>
            <p class="text-xs text-slate-300 leading-normal mb-3">
              Structural analysis, seismic evaluations, AutoCAD Civil 3D/SWMM modeling, and building permit approvals across Canada and the United States.
            </p>
            <a href="/consult" class="text-[11px] font-mono text-amber-construction uppercase tracking-wider hover:underline flex items-center gap-1">
              <span>View Consult Focus</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>

          <!-- Global Entity Box -->
          <div class="p-4 bg-navy-900 border-l-2 border-amber-construction border-t border-r border-b border-navy-800">
            <div class="flex items-center justify-between mb-2">
              <span class="font-display font-bold text-white text-sm uppercase">Swift Global Inc.</span>
              <span class="font-mono text-[10px] text-amber-construction">swiftglobalinc.com</span>
            </div>
            <p class="text-xs text-slate-300 leading-normal mb-3">
              Heavy equipment sourcing, technical bid evaluation, petrochemical plant modernizations, and turnkey EPC delivery across the Middle East & West Africa.
            </p>
            <a href="/global" class="text-[11px] font-mono text-amber-construction uppercase tracking-wider hover:underline flex items-center gap-1">
              <span>View Global Focus</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>

      </div>

      <!-- Right Column: Quick RFP & Callout -->
      <div class="lg:col-span-4 p-6 sm:p-8 bg-navy-900 border border-steel-500/30 flex flex-col justify-between">
        <div class="space-y-4">
          <div class="text-[11px] font-mono uppercase tracking-architect text-steel-400">
            Centralized Engagement
          </div>
          <h3 class="text-xl font-display font-bold text-white uppercase">
            Work With Both Entities Under One Single Contract
          </h3>
          <p class="text-xs text-slate-300 leading-relaxed">
            Our multi-model delivery structures (EPC, Design-Build, CM at-Risk) allow you to contract through either entity with unified insurance, legal, and operational continuity.
          </p>
        </div>

        <div class="pt-6">
          <Button href="/contact" variant="accent" size="md" class="w-full">
            Request Unified Consultation
          </Button>
        </div>
      </div>

    </div>
  </div>
</section>
