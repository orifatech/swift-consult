---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Button from '@/components/ui/Button.astro';
import Badge from '@/components/ui/Badge.astro';
import { ENTITIES, type EntityKey } from '@/data/companyData';

interface Props {
  defaultEntity?: EntityKey;
}

const { defaultEntity = 'group' } = Astro.props;
---

<section id="contact" class="py-20 lg:py-24 bg-blueprint-bg border-b border-slate-200" aria-labelledby="contact-title">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      
      <!-- Left Column: Contact Details & Office Specs -->
      <div class="lg:col-span-5 space-y-8">
        <div>
          <div class="font-mono text-xs text-steel-600 uppercase tracking-architect mb-2">
            05 // Direct Engagement
          </div>
          <h2 id="contact-title" class="text-3xl sm:text-4xl font-display font-bold uppercase tracking-tight text-navy-900 leading-tight">
            Discuss Your Next Project or Submit an RFP
          </h2>
          <div class="w-12 h-0.5 mt-3 mb-4 bg-steel-500" aria-hidden="true"></div>
          <p class="text-sm text-slate-600 font-sans leading-relaxed">
            Connect directly with our engineering partners and global procurement directors in Toronto. We provide comprehensive bid packages, feasibility evaluations, and municipal consultation.
          </p>
        </div>

        <!-- Headquarters Card -->
        <div class="bg-white border border-slate-300 p-6 space-y-4">
          <div class="flex items-center justify-between pb-3 border-b border-slate-200">
            <span class="font-mono text-xs font-bold uppercase tracking-wider text-navy-900">
              Corporate Headquarters
            </span>
            <Badge variant="gold">Toronto, Canada</Badge>
          </div>

          <div class="space-y-3 font-mono text-xs text-slate-700">
            <div class="flex items-start gap-3">
              <span class="text-steel-600 font-bold select-none" aria-hidden="true">HQ:</span>
              <div>
                <strong class="font-semibold text-navy-900">Swift Consult Inc. / Swift Global Inc.</strong>
                <p class="text-slate-600 font-sans text-xs mt-0.5">1000 King Street West, Toronto, ON, M6K 3N1</p>
              </div>
            </div>

            <div class="flex items-center gap-3">
              <span class="text-steel-600 font-bold select-none" aria-hidden="true">TEL:</span>
              <a href="tel:+15875663166" class="text-navy-900 hover:text-steel-600 font-semibold underline">
                +1 (587) 566-3166
              </a>
            </div>

            <div class="pt-2 border-t border-slate-100 space-y-2">
              <div>
                <span class="text-slate-500 text-[10px] uppercase block">Swift Consult Inquiries:</span>
                <a href="mailto:info@swiftconsultinc.com" class="text-steel-600 hover:text-navy-900 font-semibold">
                  info@swiftconsultinc.com
                </a>
              </div>

              <div>
                <span class="text-slate-500 text-[10px] uppercase block">Swift Global Inquiries:</span>
                <a href="mailto:info@swiftglobalinc.com" class="text-steel-600 hover:text-navy-900 font-semibold">
                  info@swiftglobalinc.com
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Dual Domain Transparency Note -->
        <div class="p-4 bg-navy-950 text-white border border-navy-800 space-y-2 font-mono text-xs">
          <div class="text-[10px] text-amber-construction uppercase tracking-wider font-semibold">
            Operational Dual Domains
          </div>
          <p class="text-slate-300 font-sans text-xs leading-normal">
            Both corporate URLs operate under shared executive governance:
          </p>
          <div class="grid grid-cols-2 gap-2 pt-1 text-[11px]">
            <div class="p-2 bg-navy-900 border border-navy-800">
              <span class="text-steel-400 block text-[9px]">ENGINEERING:</span>
              <strong class="text-white">swiftconsultinc.com</strong>
            </div>
            <div class="p-2 bg-navy-900 border border-navy-800">
              <span class="text-steel-400 block text-[9px]">GLOBAL EPC:</span>
              <strong class="text-white">swiftglobalinc.com</strong>
            </div>
          </div>
        </div>

      </div>

      <!-- Right Column: Interactive Consultation / RFP Form -->
      <div class="lg:col-span-7 bg-white border border-slate-300 p-8 sm:p-10">
        
        <div class="mb-6 pb-4 border-b border-slate-200">
          <h3 class="text-xl font-display font-bold uppercase tracking-tight text-navy-900">
            Request an Engineering Consultation or RFP Bid
          </h3>
          <p class="text-xs text-slate-500 font-mono mt-1">
            CONFIDENTIAL // DIRECT REVIEW BY SENIOR PROJECT PRINCIPALS
          </p>
        </div>

        <form class="space-y-5" onsubmit="event.preventDefault(); alert('Thank you. Your project brief has been received. A senior engineer will contact you within 24 hours.');">
          
          <!-- Name & Company -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="contact-name" class="block font-mono text-xs uppercase tracking-wider text-slate-700 mb-1.5">
                Full Name <span class="text-red-500">*</span>
              </label>
              <input
                type="text"
                id="contact-name"
                name="name"
                required
                placeholder="e.g. Marcus Vance, P.Eng"
                class="w-full px-3.5 py-2.5 text-xs font-sans bg-slate-50 border border-slate-300 focus:bg-white focus:border-navy-900 focus:outline-none rounded-none text-navy-900"
              />
            </div>

            <div>
              <label for="contact-company" class="block font-mono text-xs uppercase tracking-wider text-slate-700 mb-1.5">
                Organization / Client <span class="text-red-500">*</span>
              </label>
              <input
                type="text"
                id="contact-company"
                name="company"
                required
                placeholder="e.g. Apex Infrastructure Partners"
                class="w-full px-3.5 py-2.5 text-xs font-sans bg-slate-50 border border-slate-300 focus:bg-white focus:border-navy-900 focus:outline-none rounded-none text-navy-900"
              />
            </div>
          </div>

          <!-- Email & Phone -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="contact-email" class="block font-mono text-xs uppercase tracking-wider text-slate-700 mb-1.5">
                Work Email Address <span class="text-red-500">*</span>
              </label>
              <input
                type="email"
                id="contact-email"
                name="email"
                required
                placeholder="name@company.com"
                class="w-full px-3.5 py-2.5 text-xs font-sans bg-slate-50 border border-slate-300 focus:bg-white focus:border-navy-900 focus:outline-none rounded-none text-navy-900"
              />
            </div>

            <div>
              <label for="contact-phone" class="block font-mono text-xs uppercase tracking-wider text-slate-700 mb-1.5">
                Telephone Number
              </label>
              <input
                type="tel"
                id="contact-phone"
                name="phone"
                placeholder="+1 (555) 000-0000"
                class="w-full px-3.5 py-2.5 text-xs font-sans bg-slate-50 border border-slate-300 focus:bg-white focus:border-navy-900 focus:outline-none rounded-none text-navy-900"
              />
            </div>
          </div>

          <!-- Target Entity & Sector Selection -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="contact-entity" class="block font-mono text-xs uppercase tracking-wider text-slate-700 mb-1.5">
                Inquiring Entity / Scope
              </label>
              <select
                id="contact-entity"
                name="target_entity"
                class="w-full px-3.5 py-2.5 text-xs font-sans bg-slate-50 border border-slate-300 focus:bg-white focus:border-navy-900 focus:outline-none rounded-none text-navy-900"
              >
                <option value="both" selected={defaultEntity === 'group'}>Both Entities // Integrated Turnkey EPC</option>
                <option value="consult" selected={defaultEntity === 'consult'}>Swift Consult Inc. (Engineering &amp; Permitting)</option>
                <option value="global" selected={defaultEntity === 'global'}>Swift Global Inc. (Procurement &amp; Heavy Industrial)</option>
              </select>
            </div>

            <div>
              <label for="contact-sector" class="block font-mono text-xs uppercase tracking-wider text-slate-700 mb-1.5">
                Project Sector
              </label>
              <select
                id="contact-sector"
                name="sector"
                class="w-full px-3.5 py-2.5 text-xs font-sans bg-slate-50 border border-slate-300 focus:bg-white focus:border-navy-900 focus:outline-none rounded-none text-navy-900"
              >
                <option value="commercial">Commercial Building &amp; Development</option>
                <option value="industrial">Industrial Engineering &amp; Facilities</option>
                <option value="residential">Residential Buildings &amp; Development</option>
                <option value="civil">Civil, Municipal &amp; Site Infrastructure</option>
                <option value="procurement">Heavy Equipment Procurement</option>
              </select>
            </div>
          </div>

          <!-- Project Description -->
          <div>
            <label for="contact-message" class="block font-mono text-xs uppercase tracking-wider text-slate-700 mb-1.5">
              Project Description &amp; Technical Requirements <span class="text-red-500">*</span>
            </label>
            <textarea
              id="contact-message"
              name="message"
              rows="4"
              required
              placeholder="Outline project location, anticipated timeline, target delivery model (EPC, Design-Build, or Consulting), and core challenges..."
              class="w-full px-3.5 py-2.5 text-xs font-sans bg-slate-50 border border-slate-300 focus:bg-white focus:border-navy-900 focus:outline-none rounded-none text-navy-900"
            ></textarea>
          </div>

          <!-- Submit Button -->
          <div class="pt-2">
            <Button type="submit" variant="primary" size="lg" class="w-full sm:w-auto">
              Submit Technical Inquiry →
            </Button>
            <p class="mt-2 text-[11px] text-slate-500 font-mono">
              Inquiries are handled under strict NDA. Toronto team responds within 1 business day.
            </p>
          </div>

        </form>

      </div>

    </div>

  </div>
</section>
