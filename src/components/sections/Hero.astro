---
import Button from '@/components/ui/Button.astro';
import Badge from '@/components/ui/Badge.astro';
import ArchitecturalFrame from '@/components/ui/ArchitecturalFrame.astro';
import ResponsivePicture from '@/components/ui/ResponsivePicture.astro';
import { ENTITIES, type EntityKey } from '@/data/companyData';

interface Props {
  entity?: EntityKey;
}

const { entity = 'group' } = Astro.props;
const current = ENTITIES[entity];

const heroContent = {
  group: {
    eyebrow: 'Integrated Global EPC Practice',
    title: 'End-to-End Engineering, Global Procurement & Construction Delivery.',
    description: 'Uniting Canadian engineering precision and regulatory authority with international supply chain procurement. Delivering complex commercial, industrial, and infrastructure developments across Canada, the United States, the Middle East, and West Africa.',
    imageDesktop: '/images/commercial-tower.webp',
    imageMobile: '/images/commercial-tower-mobile.webp',
    specCode: 'CODE: OBC / NBC / ACI / CSA-S16',
    coord: 'HQ: 43.6426°N, 79.4143°W [TORONTO]',
    primaryCta: 'Request a Consultation',
    secondaryCta: 'View Global Portfolio'
  },
  consult: {
    eyebrow: 'Swift Consult Inc. // Engineering & Design',
    title: 'Precision Structural Engineering, Civil Systems & Municipal Approvals.',
    description: 'Specializing in structural analysis, seismic resilience, mass timber, municipal servicing, and expedited regulatory approvals for commercial, residential, and institutional developments across North America.',
    imageDesktop: '/images/structural-engineering.webp',
    imageMobile: '/images/structural-engineering-mobile.webp',
    specCode: 'SPEC: FEA SEISMIC & CIVIL 3D',
    coord: 'DOM: SWIFTCONSULTINC.COM',
    primaryCta: 'Discuss Engineering Project',
    secondaryCta: 'Explore Technical Disciplines'
  },
  global: {
    eyebrow: 'Swift Global Inc. // Procurement & EPC',
    title: 'Heavy Industrial Engineering, International Procurement & Turnkey EPC.',
    description: 'Empowering major industrial facilities and cross-border infrastructure with specialized equipment sourcing, vendor prequalification, and turnkey EPC management across the Middle East, West Africa, and North America.',
    imageDesktop: '/images/global-logistics.webp',
    imageMobile: '/images/global-logistics-mobile.webp',
    specCode: 'SCOPE: HEAVY INDUSTRIAL SUPPLY CHAIN',
    coord: 'DOM: SWIFTGLOBALINC.COM',
    primaryCta: 'Initiate Procurement RFP',
    secondaryCta: 'View Industrial Operations'
  }
};

const content = heroContent[entity];
---

<section class="relative bg-navy-950 text-white overflow-hidden border-b border-navy-800" aria-label="Hero Introduction">
  <!-- Blueprint Grid Pattern Overlay -->
  <div class="absolute inset-0 bg-blueprint-grid-dark opacity-70 pointer-events-none" aria-hidden="true"></div>

  <!-- Subtle Accent Light Glow -->
  <div class="absolute -top-32 -right-32 w-96 h-96 bg-steel-600/15 filter blur-3xl pointer-events-none" aria-hidden="true"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24 lg:py-28">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Column: Copy & Actions -->
      <div class="lg:col-span-7 space-y-6">
        
        <!-- Entity Indicator & Status -->
        <div class="flex flex-wrap items-center gap-2.5">
          <Badge variant="gold" size="md">
            {content.eyebrow}
          </Badge>
          <span class="text-xs font-mono text-slate-400">
            {entity === 'group' ? 'Equal Dual-Entity Operation' : `Direct Entity Focus: ${current.name}`}
          </span>
        </div>

        <!-- Main Headline -->
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-display font-extrabold uppercase tracking-tight text-white leading-[1.12]">
          {content.title}
        </h1>

        <!-- Core Value Proposition -->
        <p class="text-base sm:text-lg text-slate-300 font-sans leading-relaxed max-w-2xl">
          {content.description}
        </p>

        <!-- CTA Action Buttons -->
        <div class="pt-4 flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5">
          <Button href="/contact" variant="accent" size="lg">
            {content.primaryCta}
            <span aria-hidden="true">→</span>
          </Button>
          <Button href={entity === 'consult' ? '/services' : entity === 'global' ? '/sectors' : '/projects'} variant="outline" size="lg" class="text-white border-white/30 hover:border-white hover:bg-white/10">
            {content.secondaryCta}
          </Button>
        </div>

        <!-- Global Delivery Badges -->
        <div class="pt-6 border-t border-navy-850">
          <div class="text-[11px] font-mono text-slate-400 uppercase tracking-architect mb-3">
            Global Delivery Capabilities:
          </div>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 font-mono text-xs text-slate-200">
            <div class="p-2.5 bg-navy-900 border border-navy-800">
              <span class="text-steel-400 block text-[10px]">REGION 01</span>
              <span class="font-semibold text-white">🇨🇦 Canada (HQ)</span>
            </div>
            <div class="p-2.5 bg-navy-900 border border-navy-800">
              <span class="text-steel-400 block text-[10px]">REGION 02</span>
              <span class="font-semibold text-white">🇺🇸 United States</span>
            </div>
            <div class="p-2.5 bg-navy-900 border border-navy-800">
              <span class="text-steel-400 block text-[10px]">REGION 03</span>
              <span class="font-semibold text-white">🇦🇪 Middle East</span>
            </div>
            <div class="p-2.5 bg-navy-900 border border-navy-800">
              <span class="text-steel-400 block text-[10px]">REGION 04</span>
              <span class="font-semibold text-white">🇳🇬 West Africa</span>
            </div>
          </div>
        </div>

      </div>

      <!-- Right Column: Sharp Architectural Image Framing -->
      <div class="lg:col-span-5 relative">
        <ArchitecturalFrame
          specCode={content.specCode}
          coordLabel={content.coord}
          chamfer="tr"
          hasCornerTicks={true}
          class="border-steel-500/40 bg-navy-900"
        >
          <div class="aspect-[4/3] sm:aspect-[16/10] lg:aspect-[4/3] w-full">
            <ResponsivePicture
              desktopSrc={content.imageDesktop}
              mobileSrc={content.imageMobile}
              alt={content.title}
              width={1600}
              height={1200}
              loading="eager"
              fetchpriority="high"
              class="w-full h-full object-cover transition-transform duration-700 hover:scale-105"
            />
          </div>
        </ArchitecturalFrame>

        <!-- Floating Architectural Offset Badge -->
        <div class="hidden sm:block absolute -bottom-6 -left-6 bg-navy-900 border border-steel-500/40 p-3.5 font-mono text-xs text-slate-200 z-10">
          <div class="text-[10px] text-amber-construction uppercase font-semibold">Turnkey Execution</div>
          <div class="font-display font-bold text-white text-sm">Concept → Delivery</div>
        </div>
      </div>

    </div>
  </div>
</section>
