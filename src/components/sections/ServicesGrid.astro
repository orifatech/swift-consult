---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Badge from '@/components/ui/Badge.astro';
import Button from '@/components/ui/Button.astro';
import { SERVICES } from '@/data/companyData';

interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
}

const {
  eyebrow = 'The Technical Engine',
  title = '5 Core Engineering & Delivery Disciplines',
  subtitle = 'An integrated continuum spanning conceptual structural calculations, environmental hydrology, international procurement, and construction administration.'
} = Astro.props;
---

<section id="services" class="py-20 lg:py-24 bg-white border-b border-slate-200" aria-labelledby="services-title">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end md:justify-between mb-12 gap-6">
      <SectionHeading
        index="02"
        eyebrow={eyebrow}
        title={title}
        subtitle={subtitle}
        class="mb-0"
      />
      <div class="hidden md:block">
        <Button href="/services" variant="secondary" size="md">
          Explore Technical Engine Specs →
        </Button>
      </div>
    </div>

    <!-- 5 Core Services Grid Layout -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {SERVICES.map((service, index) => (
        <article class={`p-7 border border-slate-200 hover:border-navy-900 bg-blueprint-bg transition-all duration-200 flex flex-col justify-between group ${index === 0 ? 'lg:col-span-2' : ''}`}>
          
          <div>
            <!-- Top Card Header: Discipline Number & Entity Attribution -->
            <div class="flex items-center justify-between gap-2 mb-4 pb-3 border-b border-slate-200 font-mono">
              <span class="text-2xl font-bold font-display text-navy-900 group-hover:text-steel-600 transition-colors">
                {service.number} //
              </span>
              <Badge variant={service.entityRole.includes('Consult') ? 'steel' : service.entityRole.includes('Global') ? 'navy' : 'gold'}>
                {service.entityRole}
              </Badge>
            </div>

            <!-- Service Title -->
            <h3 class="text-xl font-display font-bold uppercase tracking-tight text-navy-900 mb-3">
              {service.title}
            </h3>

            <!-- Short Description -->
            <p class="text-xs sm:text-sm text-slate-600 font-sans leading-relaxed mb-6">
              {service.shortDesc}
            </p>

            <!-- Features & Capabilities Checklist -->
            <div class="space-y-2 mb-6">
              <div class="text-[10px] font-mono uppercase text-slate-500 tracking-wider">
                Technical Capabilities:
              </div>
              <ul class="space-y-1.5 text-xs text-slate-700" role="list">
                {service.features.slice(0, 3).map((feat) => (
                  <li class="flex items-start gap-2">
                    <span class="text-steel-500 font-mono text-xs mt-0.5" aria-hidden="true">✓</span>
                    <span>{feat}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <!-- Bottom Specs & Direct Deep Link -->
          <div class="pt-4 border-t border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-3 font-mono text-xs">
            <div class="text-[11px] text-slate-500">
              {service.keySpecs[0]?.label}: <strong class="text-navy-900 font-semibold">{service.keySpecs[0]?.value}</strong>
            </div>
            <a
              href={`/services#service-${service.number}`}
              class="text-navy-900 group-hover:text-steel-600 font-semibold uppercase tracking-wider flex items-center gap-1 hover:underline"
            >
              <span>Full Details</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>

        </article>
      ))}
    </div>

    <!-- Mobile CTA -->
    <div class="mt-8 md:hidden">
      <Button href="/services" variant="secondary" size="md" class="w-full">
        Explore Technical Engine Specs →
      </Button>
    </div>

  </div>
</section>
