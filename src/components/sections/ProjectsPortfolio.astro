---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Badge from '@/components/ui/Badge.astro';
import Button from '@/components/ui/Button.astro';
import ResponsivePicture from '@/components/ui/ResponsivePicture.astro';
import { PROJECTS, type EntityKey } from '@/data/companyData';

interface Props {
  entityFilter?: EntityKey;
  limit?: number;
  showAllLink?: boolean;
}

const { entityFilter, limit = 6, showAllLink = true } = Astro.props;

let filteredProjects = PROJECTS;
if (entityFilter === 'consult') {
  filteredProjects = PROJECTS.filter(p => p.entity === 'Swift Consult' || p.entity === 'Unified Group');
} else if (entityFilter === 'global') {
  filteredProjects = PROJECTS.filter(p => p.entity === 'Swift Global' || p.entity === 'Unified Group');
}

const displayProjects = filteredProjects.slice(0, limit);
---

<section id="projects" class="py-20 lg:py-24 bg-white border-b border-slate-200" aria-labelledby="projects-title">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="flex flex-col md:flex-row md:items-end md:justify-between mb-12 gap-6">
      <SectionHeading
        index="04"
        eyebrow="Proven Global Track Record"
        title="Featured EPC &amp; Engineering Projects"
        subtitle="Selected high-impact commissions spanning commercial towers, heavy industrial processing facilities, and complex municipal developments."
        class="mb-0"
      />

      {showAllLink && (
        <div class="hidden md:block">
          <Button href="/projects" variant="secondary" size="md">
            View All Projects ({PROJECTS.length}) →
          </Button>
        </div>
      )}
    </div>

    <!-- Project Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {displayProjects.map((project) => (
        <article class="bg-blueprint-bg border border-slate-300 hover:border-navy-900 transition-colors duration-200 flex flex-col justify-between group">
          
          <div>
            <!-- Image with Technical Header -->
            <div class="relative overflow-hidden border-b border-slate-300 bg-navy-950">
              <div class="aspect-[16/10] w-full overflow-hidden">
                <ResponsivePicture
                  desktopSrc={project.image}
                  mobileSrc={project.imageMobile}
                  alt={project.title}
                  width={1200}
                  height={750}
                  loading="lazy"
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
              </div>

              <!-- Top Left Sector Tag -->
              <div class="absolute top-3 left-3">
                <span class="px-2 py-0.5 bg-navy-950 text-white font-mono text-[10px] uppercase tracking-wider border border-white/20">
                  {project.sector}
                </span>
              </div>

              <!-- Top Right Year Tag -->
              <div class="absolute top-3 right-3 font-mono text-[10px] bg-white/90 text-navy-900 px-2 py-0.5 font-bold">
                {project.year}
              </div>

              <!-- Bottom Entity Badge -->
              <div class="absolute bottom-3 left-3">
                <Badge variant={project.entity === 'Swift Consult' ? 'steel' : project.entity === 'Swift Global' ? 'navy' : 'gold'}>
                  {project.entity}
                </Badge>
              </div>
            </div>

            <!-- Content Area -->
            <div class="p-6">
              <div class="flex items-center gap-1.5 font-mono text-[11px] text-steel-600 mb-1.5">
                <span aria-hidden="true">📍</span>
                <span>{project.location}</span>
              </div>

              <h3 class="text-lg font-display font-bold uppercase tracking-tight text-navy-900 group-hover:text-steel-600 transition-colors">
                {project.title}
              </h3>

              <p class="mt-3 text-xs sm:text-sm text-slate-600 font-sans leading-relaxed">
                {project.scope}
              </p>
            </div>
          </div>

          <!-- Bottom Metric Strip -->
          <div class="px-6 py-3 bg-white border-t border-slate-200 flex items-center justify-between font-mono text-xs">
            <span class="text-slate-500 text-[11px] uppercase">Scope Key Metric:</span>
            <span class="font-bold text-navy-900">{project.stats}</span>
          </div>

        </article>
      ))}
    </div>

    <!-- Mobile Button -->
    {showAllLink && (
      <div class="mt-8 md:hidden">
        <Button href="/projects" variant="secondary" size="md" class="w-full">
          View All Projects ({PROJECTS.length}) →
        </Button>
      </div>
    )}

  </div>
</section>
