---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'accent' | 'outline' | 'white';
  size?: 'sm' | 'md' | 'lg';
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  ariaLabel?: string;
  target?: string;
  rel?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  type = 'button',
  class: className = '',
  ariaLabel,
  target,
  rel
} = Astro.props;

const baseStyles = 'inline-flex items-center justify-center font-display font-semibold uppercase tracking-wider transition-all duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 select-none cursor-pointer rounded-xl disabled:opacity-50 disabled:pointer-events-none active:scale-[0.98]';

const sizeStyles = {
  sm: 'px-4 py-2 text-xs gap-1.5',
  md: 'px-6 py-3 text-sm gap-2',
  lg: 'px-8 py-4 text-base gap-2.5 font-bold'
};

const variantStyles = {
  primary: 'bg-navy-900 text-white hover:bg-steel-600 active:bg-navy-950 border border-navy-900 hover:border-steel-600 focus-visible:outline-steel-500 shadow-sm hover:shadow-card-hover',
  secondary: 'bg-white text-navy-900 border border-slate-300 hover:border-navy-900 hover:bg-slate-50 active:bg-slate-100 focus-visible:outline-navy-900 shadow-sm hover:shadow-card',
  accent: 'bg-steel-500 text-white hover:bg-steel-600 border border-steel-500 focus-visible:outline-navy-900 shadow-steel-glow',
  outline: 'bg-transparent text-navy-900 border border-navy-900/30 hover:border-navy-900 hover:bg-navy-900/5 focus-visible:outline-navy-900',
  white: 'bg-white text-navy-900 hover:bg-steel-50 active:bg-slate-100 border border-white focus-visible:outline-white shadow-card hover:shadow-card-hover'
};

const combinedClasses = `${baseStyles} ${sizeStyles[size]} ${variantStyles[variant]} ${className}`;
---

{href ? (
  <a
    href={href}
    class={combinedClasses}
    aria-label={ariaLabel}
    target={target}
    rel={target === '_blank' ? (rel || 'noopener noreferrer') : rel}
  >
    <slot />
  </a>
) : (
  <button
    type={type}
    class={combinedClasses}
    aria-label={ariaLabel}
  >
    <slot />
  </button>
)}
