---
import { SECTORS, SERVICES, COMPANY, ENGINEERING_ACCREDITATIONS } from '@/data/companyData';
---

<footer class="bg-navy-950 text-white border-t border-navy-900" role="contentinfo">
  <!-- Main Footer Grid -->
  <div class="max-w-7xl mx-auto px-6 md:px-10 lg:px-12 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10 md:gap-16">
      
      <!-- Col 1: Corporate Profile & Logos -->
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <img
            src="/images/swift-consult-logo.svg"
            alt="Swift Consult Inc."
            width="280"
            height="62"
            class="h-10 sm:h-12 w-auto brightness-200"
            loading="lazy"
          />
        </div>

        <p class="text-sm text-slate-300 leading-relaxed font-sans max-w-md">
          {COMPANY.description}
        </p>

        <!-- Technical Accreditations & Codes -->
        <div class="space-y-2 pt-2">
          <div class="text-xs font-mono uppercase tracking-wider text-steel-400">
            Engineering Practice &amp; Regulatory Licensure:
          </div>
          <div class="flex flex-wrap gap-2 font-mono text-[10px] text-slate-200">
            {ENGINEERING_ACCREDITATIONS.slice(0, 2).map((acc) => (
              <span class="px-2.5 py-1 rounded-md bg-navy-900 border border-navy-800">
                {acc.organization}
              </span>
            ))}
          </div>
        </div>
      </div>

      <!-- Col 2: Focus Sectors -->
      <div>
        <h3 class="text-xs font-mono uppercase tracking-architect text-steel-400 mb-4 pb-1 border-b border-navy-800">
          Focus Sectors
        </h3>
        <ul class="space-y-2.5 text-sm text-slate-300 font-sans" role="list">
          {SECTORS.map((sector) => (
            <li>
              <a
                href={`/sectors#${sector.id}`}
                class="hover:text-white transition-colors flex items-center justify-between group"
              >
                <span>{sector.title}</span>
                <span class="font-mono text-xs text-slate-500 group-hover:text-steel-400 transition-colors">→</span>
              </a>
            </li>
          ))}
          <li class="pt-2">
            <a
              href="/sectors"
              class="font-mono text-xs uppercase tracking-wider text-steel-400 hover:text-white hover:underline"
            >
              All Sectors &amp; Typologies →
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Core Capabilities -->
      <div>
        <h3 class="text-sm font-mono uppercase tracking-architect text-steel-400 mb-4 pb-1 border-b border-navy-800">
          Engineering Scope
        </h3>
        <ul class="space-y-2 text-xs text-slate-300 font-sans" role="list">
          {SERVICES.map((service) => (
            <li>
              <a
                href={`/services#service-${service.number}`}
                class="hover:text-white transition-colors block py-0.5"
              >
                <span class="text-slate-500 font-mono text-xs mr-1">{service.number}.</span>
                {service.title}
              </a>
            </li>
          ))}
          <li class="pt-2">
            <a
              href="/services"
              class="font-mono text-xs uppercase tracking-wider text-steel-400 hover:text-white hover:underline"
            >
              All Capabilities →
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 4: Corporate Headquarters & Contacts -->
      <div class="space-y-4 col-span-full ">
        <div class="text-xs text-slate-300 font-mono grid grid-cols-1 sm:grid-cols-3 gap-6 xl:gap-8">
          <div class="p-3 rounded-md bg-navy-900 border border-navy-800 space-y-1.5">
            <span class="text-slate-400 block text-[10px] uppercase">Corporate Address</span>
            <span class="text-white font-sans text-xs font-medium block">{COMPANY.address}</span>
            <span class="text-slate-400 font-sans text-xs">Toronto, Ontario, Canada</span>
          </div>

          <div class="p-3 rounded-md bg-navy-900 border border-navy-800 space-y-1.5">
            <span class="text-slate-400 block text-xs uppercase">Official Email</span>
            <a href={`mailto:${COMPANY.email}`} class="font-mono text-xs text-white hover:text-steel-300 transition-colors hover:underline break-all block">
              {COMPANY.email}
            </a>
          </div>

          <div class="p-3 rounded-md bg-navy-900 border border-navy-800 space-y-1.5">
            <span class="text-slate-400 block text-[10px] uppercase">Dispatch Line</span>
            <a href="tel:+15875663166" class="text-white hover:text-steel-300 font-mono text-xs transition-colors block">
              {COMPANY.phone}
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Legal & Copyright Bar -->
  <div class="border-t border-navy-900 py-6 px-6 md:px-10 lg:px-12 text-xs font-mono bg-navy-950 text-slate-400">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row sm:flex-wrap items-center justify-between gap-3">
      <div>
        © {new Date().getFullYear()} {COMPANY.legalName} All rights reserved.
      </div>
      <div class="flex flex-wrap items-center gap-3">
        <span>Licensed P.Eng Engineering Practice</span>
        <span>•</span>
        <a href="/contact" class="hover:text-slate-300 transition-colors">
          Contact HQ
        </a>
      </div>
    </div>
  </div>
</footer>
