---
import type { EntityKey } from '@/data/companyData';

interface Props {
  currentEntity?: EntityKey;
  class?: string;
}

const { currentEntity = 'group', class: className = '' } = Astro.props;

const switcherItems = [
  {
    key: 'consult' as EntityKey,
    label: 'Swift Consult Inc.',
    href: '/consult',
    subtext: 'Engineering & Approvals',
    domain: 'swiftconsultinc.com',
  },
  {
    key: 'global' as EntityKey,
    label: 'Swift Global Inc.',
    href: '/global',
    subtext: 'Procurement & EPC',
    domain: 'swiftglobalinc.com',
  },
  {
    key: 'group' as EntityKey,
    label: 'Unified Group',
    href: '/',
    subtext: 'Integrated Holding',
    domain: 'Both Entities',
  }
];
---

<div class={`border-b border-navy-900/10 bg-navy-950 text-white ${className}`} role="region" aria-label="Company Entity Lens Selection">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between py-1.5 gap-2 text-xs">
      
      <!-- Informational Context Indicator -->
      <div class="flex items-center gap-2 font-mono text-[11px] text-slate-300">
        <span class="w-1.5 h-1.5 bg-amber-construction animate-pulse inline-block" aria-hidden="true"></span>
        <span class="uppercase tracking-wider text-slate-400">Multi-Entity Architecture:</span>
        <span class="text-white font-medium hidden sm:inline">2 Sister Entities • 1 Integrated EPC Platform</span>
      </div>

      <!-- Entity Switcher Buttons -->
      <nav aria-label="Switch company view" class="flex items-center gap-1 overflow-x-auto pb-0.5 md:pb-0">
        <span class="text-[10px] font-mono text-slate-400 uppercase tracking-widest mr-1.5 hidden lg:inline">Active Lens:</span>
        {switcherItems.map((item) => {
          const isActive = currentEntity === item.key;
          return (
            <a
              href={item.href}
              aria-current={isActive ? 'page' : undefined}
              class={`px-2.5 py-1 text-[11px] font-mono uppercase tracking-wider transition-colors duration-150 flex items-center gap-1.5 whitespace-nowrap rounded-none ${
                isActive
                  ? 'bg-steel-500 text-white font-semibold border-b-2 border-amber-construction'
                  : 'bg-navy-900/80 text-slate-300 hover:text-white hover:bg-navy-800 border-b-2 border-transparent'
              }`}
            >
              <span>{item.label}</span>
              <span class="hidden sm:inline text-[9px] opacity-75 font-normal">({item.subtext})</span>
            </a>
          );
        })}
      </nav>

    </div>
  </div>
</div>
