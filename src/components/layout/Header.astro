---
import Button from '@/components/ui/Button.astro';
import { ENTITIES, type EntityKey } from '@/data/companyData';

interface Props {
  currentEntity?: EntityKey;
  activePath?: string;
}

const { currentEntity = 'consult', activePath = '/consult' } = Astro.props;
const activeCompany = ENTITIES[currentEntity] || ENTITIES.consult;
const cross = activeCompany.crossEntity;
const isGlobal = currentEntity === 'global';
---

<header class={`sticky top-0 z-50 border-b transition-colors duration-150 ${
  isGlobal
    ? 'bg-navy-950/95 backdrop-blur-md border-navy-800 text-white'
    : 'bg-white/95 backdrop-blur-md border-slate-200 text-navy-900'
}`}>
  
  <!-- Prominent Cross-Entity Switcher Banner -->
  <div class={`py-1.5 px-4 sm:px-6 lg:px-8 text-xs font-mono border-b ${
    isGlobal
      ? 'bg-black text-slate-300 border-navy-900'
      : 'bg-navy-950 text-slate-200 border-navy-900'
  }`}>
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-2">
      
      <!-- Current Site Indicator & Gateway Return Link -->
      <div class="flex items-center gap-3">
        <a
          href="/"
          class="flex items-center gap-1.5 px-2 py-0.5 bg-navy-900 hover:bg-steel-600 text-slate-200 hover:text-white border border-slate-700 transition-colors uppercase text-[10px] tracking-wider"
          title="Return to the Fullscreen Gateway Portal"
        >
          <span aria-hidden="true">⊞</span>
          <span>Portal Gateway</span>
        </a>
        <div class="flex items-center gap-2 text-[11px]">
          <span class={`w-2 h-2 inline-block ${isGlobal ? 'bg-amber-construction animate-pulse' : 'bg-steel-400'}`}></span>
          <span class="text-slate-400 uppercase tracking-widest text-[10px]">Active Website:</span>
          <strong class="text-white font-semibold">{activeCompany.name}</strong>
        </div>
      </div>

      <!-- Prominent Cross-Entity Switcher Button -->
      <a
        href={cross.targetHref}
        class={`px-3 py-1 font-mono text-[11px] font-bold uppercase tracking-wider transition-all duration-150 flex items-center gap-2 border ${
          isGlobal
            ? 'bg-steel-500 hover:bg-steel-400 text-white border-steel-400 shadow-sm'
            : 'bg-amber-construction hover:bg-amber-400 text-navy-950 border-amber-300 font-extrabold shadow-sm'
        }`}
        aria-label={`Switch to ${cross.targetName} website`}
      >
        <span>{cross.ctaLabel}</span>
        <span class="text-[9px] opacity-80 hidden md:inline">({cross.targetSubtitle})</span>
      </a>

    </div>
  </div>

  <!-- Main Navigation Bar -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo -->
      <a
        href={currentEntity === 'global' ? '/global' : '/consult'}
        class="flex items-center py-2 group focus-visible:outline-steel-500"
        aria-label={`${activeCompany.name} Home`}
      >
        <div class="h-11 sm:h-13 w-auto flex items-center">
          <img
            src={activeCompany.logoSvg}
            alt={activeCompany.legalName}
            width="260"
            height="58"
            class={`h-10 sm:h-12 w-auto object-contain ${isGlobal ? 'brightness-125' : ''}`}
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </a>

      <!-- Desktop Nav Items -->
      <nav class="hidden lg:flex items-center space-x-1" aria-label="Main Navigation">
        {activeCompany.navLinks.map((link) => {
          const isHomeLink = link.href === '/consult' || link.href === '/global';
          const isActive = isHomeLink ? activePath === link.href : activePath.startsWith(link.href);
          
          return (
            <a
              href={link.href}
              aria-current={isActive ? 'page' : undefined}
              class={`px-3.5 py-2 text-xs font-display font-semibold uppercase tracking-wider transition-colors duration-150 ${
                isActive
                  ? isGlobal
                    ? 'text-amber-construction border-b-2 border-amber-construction font-bold bg-navy-900/40'
                    : 'text-navy-900 border-b-2 border-navy-900 font-bold bg-slate-50'
                  : isGlobal
                    ? 'text-slate-300 hover:text-white hover:bg-navy-900/60 border-b-2 border-transparent'
                    : 'text-slate-600 hover:text-navy-900 hover:bg-slate-50 border-b-2 border-transparent'
              }`}
            >
              {link.label}
            </a>
          );
        })}
      </nav>

      <!-- Right CTAs & Contact Info -->
      <div class="hidden sm:flex items-center gap-4">
        <!-- Direct Phone Link -->
        <a
          href="tel:+15875663166"
          class="flex flex-col text-right font-mono group focus-visible:outline-steel-500"
          aria-label="Call Toronto office at +1 (587) 566-3166"
        >
          <span class={`text-[10px] uppercase tracking-wider ${isGlobal ? 'text-slate-400' : 'text-slate-500'}`}>
            Toronto Dispatch
          </span>
          <span class={`text-xs font-semibold transition-colors ${
            isGlobal ? 'text-white group-hover:text-amber-construction' : 'text-navy-900 group-hover:text-steel-600'
          }`}>
            +1 (587) 566-3166
          </span>
        </a>

        <!-- Consultation/RFP Button -->
        <Button
          href={isGlobal ? '/global/contact' : '/consult/contact'}
          variant={isGlobal ? 'accent' : 'primary'}
          size="sm"
        >
          {isGlobal ? 'Submit Procurement RFP' : 'Request Consultation'}
        </Button>
      </div>

      <!-- Mobile Hamburger Button -->
      <div class="flex lg:hidden items-center gap-2">
        <a
          href={isGlobal ? '/global/contact' : '/consult/contact'}
          class={`sm:hidden px-3 py-1.5 text-xs font-display font-semibold uppercase tracking-wider ${
            isGlobal ? 'bg-amber-construction text-navy-950' : 'bg-navy-900 text-white'
          }`}
        >
          Contact
        </a>
        <button
          type="button"
          id="mobile-menu-button"
          class={`p-2.5 focus-visible:outline-steel-500 rounded-none border ${
            isGlobal
              ? 'text-white bg-navy-900 border-navy-700 hover:bg-navy-800'
              : 'text-navy-900 bg-white border-slate-200 hover:bg-slate-100'
          }`}
          aria-label="Open navigation menu"
          aria-expanded="false"
          aria-controls="mobile-nav-menu"
        >
          <svg id="hamburger-icon" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="close-icon" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div
    id="mobile-nav-menu"
    class={`hidden lg:hidden border-t ${
      isGlobal ? 'bg-navy-950 border-navy-800 text-white' : 'bg-white border-slate-200 text-slate-800'
    }`}
    role="region"
    aria-label="Mobile Navigation"
  >
    <div class="px-4 pt-4 pb-6 space-y-3">
      
      <!-- Prominent Switcher Box in Mobile Drawer -->
      <div class={`p-3.5 border ${
        isGlobal ? 'bg-black border-navy-800' : 'bg-slate-50 border-slate-300'
      }`}>
        <div class="text-[10px] font-mono uppercase text-slate-400 tracking-widest mb-1.5">
          Need Sister Entity Services?
        </div>
        <a
          href={cross.targetHref}
          class={`block w-full text-center py-2 px-3 font-mono text-xs font-bold uppercase tracking-wider ${
            isGlobal
              ? 'bg-steel-500 text-white hover:bg-steel-400'
              : 'bg-amber-construction text-navy-950 hover:bg-amber-400'
          }`}
        >
          {cross.ctaLabel}
        </a>
      </div>

      <!-- Navigation Links -->
      <div class="space-y-1">
        {activeCompany.navLinks.map((link) => (
          <a
            href={link.href}
            class={`block px-3 py-2 text-sm font-display font-medium uppercase tracking-wider border-l-2 ${
              isGlobal
                ? 'text-slate-200 hover:bg-navy-900 border-transparent hover:border-amber-construction'
                : 'text-slate-700 hover:bg-slate-100 hover:text-navy-900 border-transparent hover:border-navy-900'
            }`}
          >
            {link.label}
          </a>
        ))}
        <a
          href="/"
          class={`block px-3 py-2 text-xs font-mono uppercase tracking-wider border-l-2 border-dashed ${
            isGlobal ? 'text-slate-400 hover:text-white border-slate-700' : 'text-slate-500 hover:text-navy-900 border-slate-300'
          }`}
        >
          ⊞ Return to Fullscreen Gateway
        </a>
      </div>

      <!-- Contact Info In Mobile Drawer -->
      <div class={`pt-4 border-t font-mono text-xs space-y-2 ${
        isGlobal ? 'border-navy-800 text-slate-300' : 'border-slate-200 text-slate-600'
      }`}>
        <div><strong class={isGlobal ? 'text-white' : 'text-navy-900'}>Toronto Office:</strong> 1000 King Street West</div>
        <div><strong class={isGlobal ? 'text-white' : 'text-navy-900'}>Phone:</strong> <a href="tel:+15875663166" class="underline">+1 (587) 566-3166</a></div>
        <div><strong class={isGlobal ? 'text-white' : 'text-navy-900'}>Email:</strong> <a href={`mailto:${activeCompany.email}`} class="underline">{activeCompany.email}</a></div>
      </div>
    </div>
  </div>
</header>

<script>
  const menuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-nav-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  if (menuButton && mobileMenu && hamburgerIcon && closeIcon) {
    menuButton.addEventListener('click', () => {
      const isExpanded = menuButton.getAttribute('aria-expanded') === 'true';
      menuButton.setAttribute('aria-expanded', String(!isExpanded));
      mobileMenu.classList.toggle('hidden');
      hamburgerIcon.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !mobileMenu.classList.contains('hidden')) {
        menuButton.setAttribute('aria-expanded', 'false');
        mobileMenu.classList.add('hidden');
        hamburgerIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
        menuButton.focus();
      }
    });
  }
</script>
