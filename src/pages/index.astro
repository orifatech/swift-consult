---
import Layout from '@/layouts/Layout.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import ArchitecturalFrame from '@/components/ui/ArchitecturalFrame.astro';
import Button from '@/components/ui/Button.astro';
import Badge from '@/components/ui/Badge.astro';
import ResponsivePicture from '@/components/ui/ResponsivePicture.astro';
import { SERVICES, PROJECTS, COMPANY } from '@/data/companyData';

const sister = COMPANY.sisterCompany;
---

<Layout
  title="Structural Engineering, Civil Design & Municipal Approvals"
  description="Swift Consult Inc. delivers professional structural engineering calculations, AutoCAD Civil 3D site servicing, SWMM hydraulic modeling, and municipal building permit approvals across Canada and the US."
  activePath="/"
  preloadImage="/images/bim-engineering-model.webp"
  preloadImageMobile="/images/bim-engineering-model-mobile.webp"
>

  <!-- Hero Section -->
  <section class="relative bg-navy-950 text-white overflow-hidden border-b border-navy-850" aria-label="Swift Consult Hero">
    <div class="absolute inset-0 bg-blueprint-grid-dark opacity-60 pointer-events-none" aria-hidden="true"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24 lg:py-28">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
        
        <!-- Left: Value Proposition -->
        <div class="lg:col-span-7 space-y-6">
          <div class="flex items-center gap-2.5">
            <Badge variant="steel">Licensed Engineering Practice</Badge>
            <span class="text-xs font-mono text-steel-300">PEO • APEGA • EGBC</span>
          </div>

          <h1 class="text-3xl sm:text-5xl lg:text-6xl font-display font-extrabold uppercase tracking-tight text-white leading-[1.1]">
            Structural Precision. <br/>
            <span class="text-steel-400">Civil Systems.</span> <br/>
            Guaranteed Permitting.
          </h1>

          <p class="text-base sm:text-lg text-slate-300 font-sans leading-relaxed max-w-2xl">
            Swift Consult Inc. delivers rigorous structural calculations, seismic analysis, AutoCAD Civil 3D site servicing, and fast-tracked municipal building permit approvals across North America.
          </p>

          <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
            <Button href="/contact" variant="primary" size="lg">
              Book Engineering Consultation →
            </Button>
            <Button href="/services" variant="white" size="lg">
              Explore Disciplines
            </Button>
          </div>

          <!-- Code Compliance Ribbon -->
          <div class="pt-6 border-t border-navy-800/80">
            <div class="text-[11px] font-mono text-slate-400 uppercase tracking-architect mb-3">
              Standard Compliance &amp; Regulatory Authorities:
            </div>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 font-mono text-xs text-slate-200">
              <div class="p-3 rounded-xl bg-navy-900/90 border border-navy-800">
                <span class="text-steel-400 block text-[10px]">STRUCTURAL</span>
                <span class="font-semibold text-white">CSA S16 / S6</span>
              </div>
              <div class="p-3 rounded-xl bg-navy-900/90 border border-navy-800">
                <span class="text-steel-400 block text-[10px]">CONCRETE</span>
                <span class="font-semibold text-white">ACI 318 / CSA A23</span>
              </div>
              <div class="p-3 rounded-xl bg-navy-900/90 border border-navy-800">
                <span class="text-steel-400 block text-[10px]">REGULATORY</span>
                <span class="font-semibold text-white">OBC / NBC / IBC</span>
              </div>
              <div class="p-3 rounded-xl bg-navy-900/90 border border-navy-800">
                <span class="text-steel-400 block text-[10px]">HYDROLOGY</span>
                <span class="font-semibold text-white">SWMM / Civil 3D</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Right: Modern Visual Frame -->
        <div class="lg:col-span-5 relative">
          <ArchitecturalFrame
            specCode="BIM-LOD400 / CSA-S16"
            coordLabel="TORONTO: 43.6426°N"
            class="border-steel-500/40"
          >
            <div class="aspect-[4/3] sm:aspect-[16/11] lg:aspect-[4/3] w-full">
              <ResponsivePicture
                desktopSrc="/images/bim-engineering-model.webp"
                mobileSrc="/images/bim-engineering-model-mobile.webp"
                alt="Swift Consult BIM Engineering Model"
                class="w-full h-full object-cover transition-transform duration-700 hover:scale-105"
                loading="eager"
              />
            </div>
          </ArchitecturalFrame>
        </div>

      </div>
    </div>
  </section>

  <!-- Core Metric Highlights -->
  <section class="py-12 bg-white border-b border-slate-200/90" aria-label="Key Performance Metrics">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
        <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 space-y-1">
          <span class="text-3xl sm:text-4xl font-display font-extrabold text-navy-900 block">100%</span>
          <span class="text-xs font-mono text-slate-500 uppercase tracking-wider block">Permit Approval Rate</span>
          <p class="text-xs text-slate-600 font-sans">First-cycle municipal submission approvals</p>
        </div>

        <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 space-y-1">
          <span class="text-3xl sm:text-4xl font-display font-extrabold text-steel-600 block">2.4M+</span>
          <span class="text-xs font-mono text-slate-500 uppercase tracking-wider block">Sq. Ft Engineered</span>
          <p class="text-xs text-slate-600 font-sans">Commercial, residential, and industrial shells</p>
        </div>

        <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 space-y-1">
          <span class="text-3xl sm:text-4xl font-display font-extrabold text-navy-900 block">140+</span>
          <span class="text-xs font-mono text-slate-500 uppercase tracking-wider block">Hectares Serviced</span>
          <p class="text-xs text-slate-600 font-sans">Civil subdivision grading and SWMM hydrology</p>
        </div>

        <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 space-y-1">
          <span class="text-3xl sm:text-4xl font-display font-extrabold text-steel-600 block">100%</span>
          <span class="text-xs font-mono text-slate-500 uppercase tracking-wider block">P.Eng Licensure</span>
          <p class="text-xs text-slate-600 font-sans">Direct oversight by licensed professional engineers</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Engineering Capabilities Matrix -->
  <section class="py-20 lg:py-28 bg-blueprint-bg" aria-labelledby="services-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-14">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div>
          <SectionHeading
            eyebrow="Discipline Portfolio"
            title="Comprehensive Engineering Services"
            lead="Specialized structural calculations, civil site engineering, and regulatory clearances backed by licensed Professional Engineers."
          />
        </div>
        <div>
          <Button href="/services" variant="secondary" size="md">
            View All Services &amp; Specs →
          </Button>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {SERVICES.map((service) => (
          <article class="bg-white rounded-2xl p-7 border border-slate-200 shadow-card hover:shadow-card-hover transition-all duration-300 flex flex-col justify-between group">
            <div class="space-y-4">
              <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                <span class="font-mono text-sm font-bold text-steel-600">{service.number} //</span>
                <span class="text-[10px] font-mono uppercase tracking-wider px-2 py-0.5 rounded-full bg-steel-50 text-steel-700 border border-steel-200">
                  {service.keySpecs[0]?.label || 'P.ENG'}
                </span>
              </div>

              <h3 class="text-xl font-display font-bold uppercase text-navy-900 group-hover:text-steel-600 transition-colors">
                {service.title}
              </h3>

              <p class="text-sm text-slate-600 font-sans leading-relaxed">
                {service.shortDesc}
              </p>

              <ul class="space-y-2 pt-2 text-xs text-slate-700 font-sans">
                {service.features.slice(0, 3).map((feature) => (
                  <li class="flex items-start gap-2">
                    <span class="text-steel-500 font-bold">✓</span>
                    <span>{feature}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="pt-6 mt-4 border-t border-slate-100">
              <a
                href={`/services#service-${service.number}`}
                class="inline-flex items-center gap-1.5 font-mono text-xs uppercase font-bold text-steel-600 group-hover:text-navy-900 transition-colors"
              >
                <span>Read Full Scope</span>
                <span class="group-hover:translate-x-1 transition-transform">→</span>
              </a>
            </div>
          </article>
        ))}
      </div>

    </div>
  </section>

  <!-- Featured Projects Showcase -->
  <section class="py-20 lg:py-28 bg-white border-t border-slate-200/90">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-14">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div>
          <SectionHeading
            eyebrow="Proven Track Record"
            title="Featured Engineering Projects"
            lead="Explore representative structural calculations, civil site designs, and municipal permit acquisitions."
          />
        </div>
        <div>
          <Button href="/projects" variant="secondary" size="md">
            View Project Catalog →
          </Button>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {PROJECTS.map((project) => (
          <article class="bg-slate-50 rounded-2xl overflow-hidden border border-slate-200 shadow-card hover:shadow-card-hover transition-all duration-300 flex flex-col justify-between group">
            <div class="relative aspect-[16/10] overflow-hidden">
              <ResponsivePicture
                desktopSrc={project.image}
                mobileSrc={project.imageMobile}
                alt={project.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
              />
              <div class="absolute top-4 left-4">
                <span class="px-3 py-1 rounded-full text-xs font-mono uppercase bg-white/90 text-navy-900 border border-slate-200 backdrop-blur-md shadow-sm">
                  {project.sector}
                </span>
              </div>
            </div>

            <div class="p-6 sm:p-8 space-y-4 flex-grow flex flex-col justify-between">
              <div class="space-y-2.5">
                <div class="flex items-center gap-2 font-mono text-xs text-slate-500">
                  <span>📍 {project.location}</span>
                  <span>•</span>
                  <span>{project.year}</span>
                </div>

                <h3 class="text-2xl font-display font-bold text-navy-900 group-hover:text-steel-600 transition-colors">
                  {project.title}
                </h3>

                <p class="text-sm text-slate-600 font-sans leading-relaxed">
                  {project.scope}
                </p>
              </div>

              <div class="pt-4 border-t border-slate-200 flex items-center justify-between text-xs font-mono">
                <span class="text-steel-600 font-bold">{project.stats}</span>
                <span class="text-slate-500">P.Eng Stamped ✓</span>
              </div>
            </div>
          </article>
        ))}
      </div>

    </div>
  </section>

  <!-- Sister Company Promo Section -->
  <section class="py-16 bg-gradient-to-r from-navy-950 via-navy-900 to-navy-950 text-white border-y border-navy-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-8 space-y-3">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-amber-400"></span>
            <span class="font-mono text-xs uppercase tracking-architect text-amber-300">
              International Industrial Operations
            </span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-display font-extrabold uppercase text-white">
            Need Heavy Equipment Procurement or Turnkey EPC?
          </h2>
          <p class="text-sm sm:text-base text-slate-300 font-sans leading-relaxed">
            Our sister entity, <strong>Swift Global Inc.</strong>, specializes in international capital equipment sourcing, Factory Acceptance Testing (FAT), marine terminal logistics, and turnkey industrial EPC facilities across North America, the Middle East, and West Africa.
          </p>
        </div>

        <div class="lg:col-span-4 flex lg:justify-end">
          <a
            href={sister.href}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-4 rounded-xl bg-amber-500 hover:bg-amber-400 text-navy-950 font-display text-sm font-bold uppercase tracking-wider transition-all shadow-lg hover:shadow-xl group"
          >
            <span>Visit Swift Global Inc.</span>
            <span class="group-hover:translate-x-1 transition-transform" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Consultation Booking Callout -->
  <section class="py-20 lg:py-24 bg-white text-navy-900 text-center">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      <Badge variant="steel">Direct Engineering Engagement</Badge>
      <h2 class="text-3xl sm:text-5xl font-display font-extrabold uppercase text-navy-900">
        Ready to Advance Your Architectural or Civil Project?
      </h2>
      <p class="text-base text-slate-600 max-w-xl mx-auto font-sans leading-relaxed">
        Speak directly with our senior structural and civil engineers. We provide prompt feasibility evaluations and clear engineering proposals.
      </p>
      <div class="pt-4 flex flex-col sm:flex-row justify-center gap-4">
        <Button href="/contact" variant="primary" size="lg">
          Schedule Engineering Consultation →
        </Button>
        <Button href="tel:+15875663166" variant="secondary" size="lg">
          Call Toronto Office: +1 (587) 566-3166
        </Button>
      </div>
    </div>
  </section>

</Layout>
