---
import Layout from '@/layouts/Layout.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import ArchitecturalFrame from '@/components/ui/ArchitecturalFrame.astro';
import Button from '@/components/ui/Button.astro';
import Badge from '@/components/ui/Badge.astro';
import ResponsivePicture from '@/components/ui/ResponsivePicture.astro';
import { SERVICES, SECTORS, PROJECTS } from '@/data/companyData';

const consultServices = SERVICES.filter(s => s.entityRole === 'Swift Consult');
const consultSectors = SECTORS.filter(s => s.leadEntity === 'Swift Consult' || s.leadEntity === 'Joint Delivery');
const consultProjects = PROJECTS.filter(p => p.entity === 'Swift Consult');
---

<Layout
  title="Structural Engineering, Civil Design & Municipal Permitting"
  description="Swift Consult Inc. delivers professional structural engineering, AutoCAD Civil 3D site servicing, SWMM hydraulic modeling, and municipal building permit approvals across Canada and the US."
  currentEntity="consult"
  activePath="/consult"
  preloadImage="/images/commercial-tower.webp"
  preloadImageMobile="/images/commercial-tower-mobile.webp"
>

  <!-- ==========================================
       HERO: BLUEPRINT PRECISION & CODE AUTHORITY
       ========================================== -->
  <section class="relative bg-navy-950 text-white overflow-hidden border-b border-navy-800" aria-label="Swift Consult Hero">
    <div class="absolute inset-0 bg-blueprint-grid-dark opacity-70 pointer-events-none" aria-hidden="true"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24 lg:py-28">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
        
        <!-- Left: Value Proposition -->
        <div class="lg:col-span-7 space-y-6">
          <div class="flex items-center gap-3">
            <Badge variant="consult">Engineering &amp; Design Consultancy</Badge>
            <span class="text-xs font-mono text-steel-400">Toronto, Ontario • North American Practice</span>
          </div>

          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-display font-extrabold uppercase tracking-tight text-white leading-[1.12]">
            Structural Precision. Civil Systems. Guaranteed Permitting.
          </h1>

          <p class="text-base sm:text-lg text-slate-300 font-sans leading-relaxed max-w-2xl">
            Swift Consult Inc. delivers rigorous structural engineering, seismic evaluations, AutoCAD Civil 3D site design, and end-to-end municipal approvals. From landmark corporate towers to complex residential subdivisions, we turn architectural vision into code-compliant reality.
          </p>

          <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5">
            <Button href="/consult/contact" variant="primary" size="lg">
              Book Engineering Consultation →
            </Button>
            <Button href="/consult/services" variant="outline" size="lg" class="text-white border-white/30 hover:border-white hover:bg-white/10">
              Explore Technical Disciplines
            </Button>
          </div>

          <!-- Technical Specs Ribbon -->
          <div class="pt-6 border-t border-navy-850">
            <div class="text-[11px] font-mono text-slate-400 uppercase tracking-architect mb-3">
              Standard Compliance &amp; Design Codes:
            </div>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 font-mono text-xs text-slate-200">
              <div class="p-2.5 bg-navy-900 border border-navy-800">
                <span class="text-steel-400 block text-[10px]">STRUCTURAL</span>
                <span class="font-semibold text-white">CSA S16 / S6</span>
              </div>
              <div class="p-2.5 bg-navy-900 border border-navy-800">
                <span class="text-steel-400 block text-[10px]">CONCRETE</span>
                <span class="font-semibold text-white">ACI 318 / CSA A23</span>
              </div>
              <div class="p-2.5 bg-navy-900 border border-navy-800">
                <span class="text-steel-400 block text-[10px]">REGULATORY</span>
                <span class="font-semibold text-white">OBC / NBC / IBC</span>
              </div>
              <div class="p-2.5 bg-navy-900 border border-navy-800">
                <span class="text-steel-400 block text-[10px]">HYDROLOGY</span>
                <span class="font-semibold text-white">SWMM / Civil 3D</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Right: Architectural Frame -->
        <div class="lg:col-span-5 relative">
          <ArchitecturalFrame
            cut="tr"
            class="border-steel-500/40 bg-navy-900"
            annotationStrip={{
              code: "P.ENG / CSA-S16 / ACI-318",
              location: "TORONTO HQ: 43.6426°N, 79.4143°W"
            }}
          >
            <div class="aspect-[4/3] sm:aspect-[16/10] lg:aspect-[4/3] w-full">
              <ResponsivePicture
                desktopSrc="/images/commercial-tower.webp"
                mobileSrc="/images/commercial-tower-mobile.webp"
                alt="Swift Consult Landmark Commercial Tower"
                aspectRatio="w-full h-full object-cover transition-transform duration-700 hover:scale-105"
                loading="eager"
              />
            </div>
          </ArchitecturalFrame>
        </div>

      </div>
    </div>
  </section>

  <!-- ==========================================
       SECTION: SISTER ENTITY PROMINENT CALLOUT
       ========================================== -->
  <section class="bg-gradient-to-r from-navy-900 via-navy-950 to-steel-950 text-white py-6 px-4 sm:px-6 lg:px-8 border-b border-navy-800">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <span class="w-3 h-3 bg-amber-construction flex-shrink-0" aria-hidden="true"></span>
        <div>
          <span class="font-mono text-xs uppercase text-amber-construction tracking-wider">Looking for International Procurement or Turnkey EPC?</span>
          <p class="text-xs text-slate-300">Visit our sister organization <strong>Swift Global Inc.</strong> for heavy equipment sourcing, plant modernization, and international logistics.</p>
        </div>
      </div>
      <a
        href="/global"
        class="flex-shrink-0 px-4 py-2 font-mono text-xs font-bold uppercase tracking-wider bg-amber-construction text-navy-950 hover:bg-amber-400 border border-amber-300 transition-colors"
      >
        Switch to Swift Global Inc. →
      </a>
    </div>
  </section>

  <!-- ==========================================
       SECTION: CORE ENGINEERING DISCIPLINES
       ========================================== -->
  <section class="py-20 lg:py-24 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between mb-12 gap-6">
        <SectionHeading
          index="01 //"
          title="Engineering & Planning Disciplines"
          subtitle="Our core engineering disciplines operate with extreme analytical rigour, ensuring structurally sound, cost-effective, and fully permitted developments."
        />
        <div>
          <Button href="/consult/services" variant="secondary" size="md">
            View All Disciplines &amp; Specs →
          </Button>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {consultServices.map((service) => (
          <article class="p-7 border border-slate-300 hover:border-navy-900 bg-blueprint-bg transition-all duration-200 flex flex-col justify-between group">
            <div>
              <div class="flex items-center justify-between mb-4 pb-3 border-b border-slate-200 font-mono">
                <span class="text-2xl font-bold font-display text-navy-900 group-hover:text-steel-600 transition-colors">
                  {service.number} //
                </span>
                <Badge variant="consult">Swift Consult</Badge>
              </div>

              <h2 class="text-xl font-display font-bold uppercase tracking-tight text-navy-900 mb-3">
                {service.title}
              </h2>

              <p class="text-xs sm:text-sm text-slate-600 font-sans leading-relaxed mb-6">
                {service.shortDesc}
              </p>

              <div class="space-y-2 mb-6">
                <div class="text-[10px] font-mono uppercase text-slate-500 tracking-wider">Scope Focus:</div>
                <ul class="space-y-1.5 text-xs text-slate-700" role="list">
                  {service.features.slice(0, 3).map((f) => (
                    <li class="flex items-start gap-2">
                      <span class="text-steel-500 font-mono text-xs mt-0.5">✓</span>
                      <span>{f}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <div class="pt-4 border-t border-slate-200 flex items-center justify-between font-mono text-xs">
              <span class="text-[11px] text-slate-500">{service.keySpecs[0]?.label}: <strong>{service.keySpecs[0]?.value}</strong></span>
              <a href={`/consult/services#service-${service.number}`} class="text-navy-900 group-hover:text-steel-600 font-semibold uppercase tracking-wider flex items-center gap-1 hover:underline">
                <span>Details</span>
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ==========================================
       SECTION: SECTORS OF OPERATION
       ========================================== -->
  <section class="py-20 lg:py-24 bg-blueprint-bg border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading
        index="02 //"
        title="Sectors of Operation"
        subtitle="Specialized structural calculations and civil design tailored for landmark commercial projects and premium residential communities."
      />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-10">
        {consultSectors.map((sector) => (
          <article class="bg-white border border-slate-300 hover:border-navy-900 transition-colors duration-200 flex flex-col group">
            <div class="aspect-[16/10] w-full overflow-hidden border-b border-slate-300">
              <ResponsivePicture
                desktopSrc={sector.imageDesktop}
                mobileSrc={sector.imageMobile}
                alt={sector.title}
                aspectRatio="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            </div>
            <div class="p-6 sm:p-8 flex-1 flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between mb-2 font-mono text-xs">
                  <span class="text-steel-600 uppercase tracking-wider font-semibold">{sector.leadEntity}</span>
                  <span class="text-slate-400">Toronto &amp; Canada</span>
                </div>
                <h2 class="text-xl font-display font-bold uppercase tracking-tight text-navy-900 mb-3">
                  {sector.title}
                </h2>
                <p class="text-xs sm:text-sm text-slate-600 font-sans leading-relaxed mb-6">
                  {sector.summary}
                </p>
                <ul class="space-y-2 text-xs text-slate-700 font-sans mb-6" role="list">
                  {sector.bulletPoints.map((b) => (
                    <li class="flex items-start gap-2">
                      <span class="text-steel-500 font-mono text-sm leading-none mt-0.5">■</span>
                      <span>{b}</span>
                    </li>
                  ))}
                </ul>
              </div>
              <div class="pt-4 border-t border-slate-200 flex items-center justify-between">
                <div class="font-mono text-xs">
                  <span class="text-slate-500 block text-[10px] uppercase">{sector.stats[0]?.label}</span>
                  <span class="text-navy-900 font-bold">{sector.stats[0]?.value}</span>
                </div>
                <Button href={`/consult/sectors#${sector.id}`} variant="secondary" size="sm">
                  Sector Scope →
                </Button>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ==========================================
       SECTION: REPRESENTATIVE CONSULT PROJECTS
       ========================================== -->
  <section class="py-20 lg:py-24 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between mb-12 gap-6">
        <SectionHeading
          index="03 //"
          title="Engineering Project Portfolio"
          subtitle="Delivering structural stability, civil servicing, and municipal permit clearance for landmark projects across Canada and the United States."
        />
        <div>
          <Button href="/consult/projects" variant="primary" size="md">
            View All Engineering Projects →
          </Button>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {consultProjects.map((p) => (
          <article class="bg-blueprint-bg border border-slate-300 hover:border-navy-900 transition-colors duration-200 flex flex-col group">
            <div class="aspect-[16/10] w-full overflow-hidden border-b border-slate-200">
              <ResponsivePicture
                desktopSrc={p.image}
                mobileSrc={p.imageMobile}
                alt={p.title}
                aspectRatio="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            </div>
            <div class="p-5 flex-1 flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between text-[11px] font-mono text-slate-500 mb-2">
                  <span>{p.location}</span>
                  <span class="text-steel-600 font-semibold">{p.year}</span>
                </div>
                <h3 class="font-display font-bold text-navy-900 text-base uppercase leading-snug mb-2 group-hover:text-steel-600 transition-colors">
                  {p.title}
                </h3>
                <p class="text-xs text-slate-600 font-sans leading-relaxed mb-4">
                  {p.scope}
                </p>
              </div>
              <div class="pt-3 border-t border-slate-200 font-mono text-xs flex items-center justify-between">
                <span class="px-2 py-0.5 bg-white border border-slate-200 text-navy-900 font-semibold text-[11px]">
                  {p.stats}
                </span>
                <span class="text-steel-600 font-bold">P.Eng Sealed</span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ==========================================
       SECTION: CONSULTATION RFP HUB
       ========================================== -->
  <section class="py-20 bg-navy-950 text-white relative overflow-hidden">
    <div class="absolute inset-0 bg-blueprint-grid-dark opacity-50 pointer-events-none" aria-hidden="true"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-7 space-y-4">
          <Badge variant="consult">Direct Engineering Dispatch</Badge>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-display font-bold uppercase tracking-tight text-white">
            Ready to Begin Structural Design or Permit Approvals?
          </h2>
          <p class="text-sm sm:text-base text-slate-300 font-sans leading-relaxed max-w-xl">
            Our Toronto headquarters handles structural engineering peer reviews, municipal site plan applications, and structural calculations for clients across Ontario and North America.
          </p>
          <div class="pt-4 flex flex-col sm:flex-row gap-4 font-mono text-xs text-slate-300">
            <div class="p-3 bg-navy-900 border border-navy-800">
              <span class="text-steel-400 block text-[10px]">DIRECT INQUIRIES:</span>
              <a href="mailto:info@swiftconsultinc.com" class="text-white hover:underline font-semibold">info@swiftconsultinc.com</a>
            </div>
            <div class="p-3 bg-navy-900 border border-navy-800">
              <span class="text-steel-400 block text-[10px]">HEADQUARTERS PHONE:</span>
              <a href="tel:+15875663166" class="text-white hover:underline font-semibold">+1 (587) 566-3166</a>
            </div>
          </div>
        </div>
        <div class="lg:col-span-5 p-6 sm:p-8 bg-navy-900 border border-steel-500/40">
          <h3 class="text-lg font-display font-bold uppercase text-white mb-2">Request Engineering Review</h3>
          <p class="text-xs text-slate-300 font-sans mb-4">Submit drawing sets or schedule an initial technical consultation with our engineering team.</p>
          <Button href="/consult/contact" variant="primary" size="md" class="w-full">
            Open Engineering Inquiry Form →
          </Button>
        </div>
      </div>
    </div>
  </section>

</Layout>
