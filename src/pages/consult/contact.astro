---
import Layout from '@/layouts/Layout.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Button from '@/components/ui/Button.astro';
import Badge from '@/components/ui/Badge.astro';
---

<Layout
  title="Contact Swift Consult Inc. | Schedule Engineering Consultation"
  description="Contact Swift Consult Inc. at our Toronto headquarters for structural engineering, Civil 3D site design, and municipal permit inquiries."
  currentEntity="consult"
  activePath="/consult/contact"
>
  <!-- Page Header -->
  <section class="bg-navy-950 text-white py-16 lg:py-20 border-b border-navy-800 relative overflow-hidden">
    <div class="absolute inset-0 bg-blueprint-grid-dark opacity-60 pointer-events-none" aria-hidden="true"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl space-y-4">
        <div class="flex items-center gap-2">
          <Badge variant="consult">Direct Engineering Contact</Badge>
          <span class="font-mono text-xs text-steel-400">Toronto Headquarters • Ontario</span>
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-display font-extrabold uppercase tracking-tight text-white leading-tight">
          Request an Engineering Consultation
        </h1>
        <p class="text-base sm:text-lg text-slate-300 font-sans leading-relaxed">
          Connect directly with our licensed structural and civil engineering team to discuss drawing sets, municipal approvals, or site servicing feasibility.
        </p>
      </div>
    </div>
  </section>

  <!-- Contact & RFP Grid -->
  <section class="py-20 lg:py-24 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        
        <!-- Left: Office & Contact Info -->
        <div class="lg:col-span-5 space-y-8">
          <div>
            <SectionHeading
              index="01 //"
              title="Toronto Engineering Headquarters"
              subtitle="All structural calculations, drawing sets, and municipal permit applications originate from our King Street West practice."
            />
          </div>

          <div class="space-y-4 font-mono text-xs">
            <div class="p-5 bg-blueprint-bg border border-slate-300">
              <span class="text-steel-600 block text-[10px] uppercase font-bold tracking-wider mb-1">PRACTICE LOCATION</span>
              <div class="font-sans text-sm font-semibold text-navy-900">Swift Consult Inc.</div>
              <div class="font-sans text-xs text-slate-600">1000 King Street West</div>
              <div class="font-sans text-xs text-slate-600">Toronto, ON, M6K 3N1, Canada</div>
            </div>

            <div class="p-5 bg-blueprint-bg border border-slate-300">
              <span class="text-steel-600 block text-[10px] uppercase font-bold tracking-wider mb-1">DIRECT TELEPHONE</span>
              <a href="tel:+15875663166" class="text-navy-900 hover:text-steel-600 text-sm font-semibold transition-colors">
                +1 (587) 566-3166
              </a>
              <div class="text-[11px] text-slate-500 font-sans mt-1">Mon–Fri: 8:00 AM – 6:00 PM EST</div>
            </div>

            <div class="p-5 bg-blueprint-bg border border-slate-300">
              <span class="text-steel-600 block text-[10px] uppercase font-bold tracking-wider mb-1">ENGINEERING INQUIRIES</span>
              <a href="mailto:info@swiftconsultinc.com" class="text-steel-600 hover:text-navy-900 text-sm font-semibold transition-colors underline break-all">
                info@swiftconsultinc.com
              </a>
              <div class="text-[11px] text-slate-500 font-sans mt-1">Direct review of drawing sets &amp; RFPs</div>
            </div>
          </div>

          <!-- Sister Entity Switch Box -->
          <div class="p-6 bg-navy-950 text-white border border-navy-800 space-y-3">
            <div class="text-[10px] font-mono uppercase text-amber-construction tracking-widest font-bold">
              Looking for Procurement or Industrial EPC?
            </div>
            <h2 class="text-base font-display font-bold uppercase text-white">
              Contact Swift Global Inc.
            </h2>
            <p class="text-xs text-slate-300 font-sans leading-relaxed">
              For heavy equipment procurement bids, vendor prequalification, and turnkey EPC delivery outside of North America:
            </p>
            <div class="pt-2">
              <Button href="/global/contact" variant="accent" size="sm" class="w-full">
                Go to Swift Global RFP Form →
              </Button>
            </div>
          </div>
        </div>

        <!-- Right: Accessible Engineering Form -->
        <div class="lg:col-span-7 bg-blueprint-bg p-8 sm:p-10 border border-slate-300">
          <div class="mb-6 pb-4 border-b border-slate-300">
            <div class="text-xs font-mono uppercase text-steel-600 font-bold tracking-wider">Formal RFP Submission</div>
            <h2 class="text-xl sm:text-2xl font-display font-bold uppercase tracking-tight text-navy-900 mt-1">
              Engineering Consultation Request
            </h2>
          </div>

          <form class="space-y-5" onsubmit="event.preventDefault(); alert('Thank you for reaching out to Swift Consult Inc. A licensed structural engineer will review your inquiry within 24 hours.');">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label for="consult-name" class="block font-mono text-xs uppercase text-slate-700 font-semibold mb-1">
                  Full Name *
                </label>
                <input
                  type="text"
                  id="consult-name"
                  name="name"
                  required
                  placeholder="e.g. Jane Doe, P.Eng"
                  class="w-full p-3 bg-white border border-slate-300 text-navy-900 text-xs font-sans rounded-none focus:outline-none focus:border-navy-900 focus:ring-1 focus:ring-navy-900"
                />
              </div>

              <div>
                <label for="consult-org" class="block font-mono text-xs uppercase text-slate-700 font-semibold mb-1">
                  Company / Organization *
                </label>
                <input
                  type="text"
                  id="consult-org"
                  name="organization"
                  required
                  placeholder="e.g. Apex Developments Corp."
                  class="w-full p-3 bg-white border border-slate-300 text-navy-900 text-xs font-sans rounded-none focus:outline-none focus:border-navy-900 focus:ring-1 focus:ring-navy-900"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label for="consult-email" class="block font-mono text-xs uppercase text-slate-700 font-semibold mb-1">
                  Corporate Email *
                </label>
                <input
                  type="email"
                  id="consult-email"
                  name="email"
                  required
                  placeholder="jane@apexcorp.ca"
                  class="w-full p-3 bg-white border border-slate-300 text-navy-900 text-xs font-sans rounded-none focus:outline-none focus:border-navy-900 focus:ring-1 focus:ring-navy-900"
                />
              </div>

              <div>
                <label for="consult-phone" class="block font-mono text-xs uppercase text-slate-700 font-semibold mb-1">
                  Telephone Number
                </label>
                <input
                  type="tel"
                  id="consult-phone"
                  name="phone"
                  placeholder="+1 (416) 000-0000"
                  class="w-full p-3 bg-white border border-slate-300 text-navy-900 text-xs font-sans rounded-none focus:outline-none focus:border-navy-900 focus:ring-1 focus:ring-navy-900"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label for="consult-service" class="block font-mono text-xs uppercase text-slate-700 font-semibold mb-1">
                  Service Discipline Needed *
                </label>
                <select
                  id="consult-service"
                  name="service"
                  required
                  class="w-full p-3 bg-white border border-slate-300 text-navy-900 text-xs font-sans rounded-none focus:outline-none focus:border-navy-900 focus:ring-1 focus:ring-navy-900"
                >
                  <option value="">Select Primary Engineering Scope</option>
                  <option value="structural-design">Structural Engineering &amp; Calculations</option>
                  <option value="civil-site">Civil, Municipal &amp; Site Servicing</option>
                  <option value="permitting-approvals">Building Permitting &amp; Planning Approvals</option>
                  <option value="seismic-review">Seismic Analysis &amp; Peer Review</option>
                  <option value="full-consultancy">Comprehensive Project Engineering</option>
                </select>
              </div>

              <div>
                <label for="consult-location" class="block font-mono text-xs uppercase text-slate-700 font-semibold mb-1">
                  Project Location / Jurisdiction
                </label>
                <input
                  type="text"
                  id="consult-location"
                  name="location"
                  placeholder="e.g. City of Toronto, ON"
                  class="w-full p-3 bg-white border border-slate-300 text-navy-900 text-xs font-sans rounded-none focus:outline-none focus:border-navy-900 focus:ring-1 focus:ring-navy-900"
                />
              </div>
            </div>

            <div>
              <label for="consult-message" class="block font-mono text-xs uppercase text-slate-700 font-semibold mb-1">
                Project Scope &amp; Target Timeline *
              </label>
              <textarea
                id="consult-message"
                name="message"
                rows="4"
                required
                placeholder="Please describe structural systems (concrete/steel/timber), storey count, municipal status, and requested engineering deliverables..."
                class="w-full p-3 bg-white border border-slate-300 text-navy-900 text-xs font-sans rounded-none focus:outline-none focus:border-navy-900 focus:ring-1 focus:ring-navy-900"
              ></textarea>
            </div>

            <div class="pt-2">
              <Button type="submit" variant="primary" size="lg" class="w-full">
                Submit Engineering Consultation Request →
              </Button>
              <div class="text-[11px] font-mono text-slate-500 text-center mt-2">
                🔒 All drawings and project data protected under engineering confidentiality.
              </div>
            </div>
          </form>
        </div>

      </div>
    </div>
  </section>
</Layout>
