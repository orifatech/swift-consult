---
import Layout from '@/layouts/Layout.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import ArchitecturalFrame from '@/components/ui/ArchitecturalFrame.astro';
import Button from '@/components/ui/Button.astro';
import Badge from '@/components/ui/Badge.astro';
import ResponsivePicture from '@/components/ui/ResponsivePicture.astro';
import { SECTORS } from '@/data/companyData';

const globalSectors = SECTORS.filter(s => s.leadEntity === 'Swift Global' || s.leadEntity === 'Joint Delivery');
---

<Layout
  title="Industrial Sectors & Facilities | Swift Global Inc."
  description="Explore the industrial and energy sectors served by Swift Global Inc., including chemical processing plants, manufacturing facilities, and deepwater logistics terminals."
  currentEntity="global"
  activePath="/global/sectors"
>
  <!-- Page Header -->
  <section class="bg-black text-white py-16 lg:py-20 border-b border-navy-800 relative overflow-hidden">
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl space-y-4">
        <div class="flex items-center gap-2">
          <Badge variant="global">Industrial Focus</Badge>
          <span class="font-mono text-xs text-amber-construction">Energy, Manufacturing &amp; Logistics</span>
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-display font-extrabold uppercase tracking-tight text-white leading-tight">
          Industrial Sectors &amp; Markets
        </h1>
        <p class="text-base sm:text-lg text-slate-300 font-sans leading-relaxed">
          Delivering critical equipment procurement, process pipe-rack fabrication, and turnkey EPC execution across high-demand industrial sectors worldwide.
        </p>
      </div>
    </div>
  </section>

  <!-- Sectors List -->
  <section class="py-20 lg:py-24 bg-slate-950 text-white border-b border-navy-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-20">
      {globalSectors.map((sector, index) => {
        const isReversed = index % 2 !== 0;
        return (
          <article id={sector.id} class="scroll-mt-28 border border-navy-800 bg-black p-8 sm:p-10 lg:p-12">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
              
              <div class={`lg:col-span-7 space-y-6 ${isReversed ? 'lg:order-2' : 'lg:order-1'}`}>
                <div class="flex items-center gap-3 font-mono">
                  <span class="px-2 py-0.5 bg-amber-950 text-amber-300 border border-amber-600/40 text-xs uppercase font-bold">
                    SEC 0{index + 1} //
                  </span>
                  <span class="text-xs text-amber-construction font-semibold uppercase">{sector.leadEntity}</span>
                </div>

                <h2 class="text-2xl sm:text-3xl font-display font-bold uppercase tracking-tight text-white">
                  {sector.title}
                </h2>

                <p class="text-sm sm:text-base text-slate-300 font-sans leading-relaxed">
                  {sector.summary}
                </p>

                <div class="space-y-3 pt-2">
                  <div class="text-[11px] font-mono uppercase text-amber-construction tracking-wider">Sector Offerings &amp; Protocols:</div>
                  <ul class="space-y-2 text-xs sm:text-sm text-slate-300" role="list">
                    {sector.bulletPoints.map((point) => (
                      <li class="flex items-start gap-2.5">
                        <span class="text-amber-construction font-mono text-sm leading-none mt-0.5">■</span>
                        <span>{point}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <div class="pt-4 border-t border-navy-850 flex flex-wrap gap-4 font-mono text-xs">
                  {sector.stats.map((s) => (
                    <div class="p-2.5 bg-navy-950 border border-navy-800">
                      <span class="text-slate-400 block text-[10px] uppercase">{s.label}</span>
                      <strong class="text-white">{s.value}</strong>
                    </div>
                  ))}
                </div>

                <div class="pt-4">
                  <Button href="/global/contact" variant="accent" size="md">
                    Discuss {sector.title} EPC →
                  </Button>
                </div>
              </div>

              <div class={`lg:col-span-5 ${isReversed ? 'lg:order-1' : 'lg:order-2'}`}>
                <ArchitecturalFrame
                  cut={isReversed ? 'bl' : 'tr'}
                  class="border-amber-500/30 bg-navy-950"
                  annotationStrip={{
                    code: sector.stats[0]?.value || 'INDUSTRIAL SECTOR',
                    location: 'MIDDLE EAST / WEST AFRICA'
                  }}
                >
                  <div class="aspect-[4/3] w-full">
                    <ResponsivePicture
                      desktopSrc={sector.imageDesktop}
                      mobileSrc={sector.imageMobile}
                      alt={sector.title}
                      aspectRatio="w-full h-full object-cover"
                    />
                  </div>
                </ArchitecturalFrame>
              </div>

            </div>
          </article>
        );
      })}
    </div>
  </section>

  <!-- Cross-Entity Prompt: Commercial & Residential -->
  <section class="py-16 bg-navy-950 text-white border-b border-navy-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-gradient-to-r from-navy-900 to-black p-8 sm:p-12 border border-steel-500/30 flex flex-col lg:flex-row items-center justify-between gap-8">
        <div class="space-y-3 max-w-2xl text-center lg:text-left">
          <Badge variant="consult">Commercial &amp; Residential Development</Badge>
          <h2 class="text-2xl sm:text-3xl font-display font-bold uppercase tracking-tight text-white">
            Need Structural Engineering for Commercial or Residential Towers?
          </h2>
          <p class="text-sm text-slate-300 font-sans leading-relaxed">
            Our sister entity <strong>Swift Consult Inc.</strong> specializes in high-rise structural systems, mass timber, and municipal building permit approvals across North American cities.
          </p>
        </div>
        <div class="flex-shrink-0">
          <Button href="/consult/sectors" variant="primary" size="lg">
            View Swift Consult Sectors →
          </Button>
        </div>
      </div>
    </div>
  </section>
</Layout>
