---
import Layout from '@/layouts/Layout.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import ArchitecturalFrame from '@/components/ui/ArchitecturalFrame.astro';
import Button from '@/components/ui/Button.astro';
import Badge from '@/components/ui/Badge.astro';
import ResponsivePicture from '@/components/ui/ResponsivePicture.astro';
import { SERVICES } from '@/data/companyData';

const globalServices = SERVICES.filter(s => s.entityRole === 'Swift Global' || s.entityRole === 'Joint Competency');
---

<Layout
  title="Procurement & EPC Services | Swift Global Inc."
  description="Explore the industrial procurement, facility modernization, and turnkey EPC capabilities offered by Swift Global Inc. across North America, the Middle East, and West Africa."
  currentEntity="global"
  activePath="/global/services"
>
  <!-- Page Header -->
  <section class="bg-black text-white py-16 lg:py-20 border-b border-navy-800 relative overflow-hidden">
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl space-y-4">
        <div class="flex items-center gap-2">
          <Badge variant="global">Execution Capabilities</Badge>
          <span class="font-mono text-xs text-amber-construction">Procurement &amp; Turnkey EPC</span>
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-display font-extrabold uppercase tracking-tight text-white leading-tight">
          Procurement &amp; EPC Services
        </h1>
        <p class="text-base sm:text-lg text-slate-300 font-sans leading-relaxed">
          From strategic international equipment sourcing to on-site turnkey EPC execution, Swift Global Inc. guarantees technical compliance, schedule integrity, and cost certainty.
        </p>
      </div>
    </div>
  </section>

  <!-- Deep-Dive Services List -->
  <section class="py-20 lg:py-24 bg-slate-950 text-white border-b border-navy-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-20">
      {globalServices.map((service, index) => {
        const isReversed = index % 2 !== 0;
        return (
          <article id={`service-${service.number}`} class="scroll-mt-28 border border-navy-800 bg-black p-8 sm:p-10 lg:p-12">
            <div class={`grid grid-cols-1 lg:grid-cols-12 gap-10 items-center ${isReversed ? 'lg:flex-row-reverse' : ''}`}>
              
              <!-- Content -->
              <div class={`lg:col-span-7 space-y-6 ${isReversed ? 'lg:order-2' : 'lg:order-1'}`}>
                <div class="flex items-center gap-3 font-mono">
                  <span class="text-3xl font-display font-bold text-amber-construction">{service.number} //</span>
                  <Badge variant="global">{service.entityRole}</Badge>
                </div>

                <h2 class="text-2xl sm:text-3xl font-display font-bold uppercase tracking-tight text-white">
                  {service.title}
                </h2>

                <p class="text-sm sm:text-base text-slate-300 font-sans leading-relaxed">
                  {service.shortDesc}
                </p>

                <div class="space-y-3 pt-2">
                  <div class="text-[11px] font-mono uppercase text-amber-construction tracking-wider">Scope Deliverables &amp; Protocols:</div>
                  <ul class="space-y-2 text-xs sm:text-sm text-slate-300" role="list">
                    {service.features.map((feature) => (
                      <li class="flex items-start gap-2.5">
                        <span class="text-amber-construction font-mono text-sm leading-none mt-0.5">■</span>
                        <span>{feature}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <div class="pt-4 border-t border-navy-850 flex flex-wrap gap-4 font-mono text-xs">
                  {service.keySpecs.map((spec) => (
                    <div class="p-2.5 bg-navy-950 border border-navy-800">
                      <span class="text-slate-400 block text-[10px] uppercase">{spec.label}</span>
                      <strong class="text-white">{spec.value}</strong>
                    </div>
                  ))}
                </div>

                <div class="pt-4">
                  <Button href="/global/contact" variant="accent" size="md">
                    Request Bid for {service.title} →
                  </Button>
                </div>
              </div>

              <!-- Media Frame -->
              <div class={`lg:col-span-5 ${isReversed ? 'lg:order-1' : 'lg:order-2'}`}>
                <ArchitecturalFrame
                  cut={isReversed ? 'bl' : 'tr'}
                  class="border-amber-500/30 bg-navy-950"
                  annotationStrip={{
                    code: service.keySpecs[0]?.value || 'ISO 9001 / ASME',
                    location: 'INTERNATIONAL EPC DELIVERY'
                  }}
                >
                  <div class="aspect-[4/3] w-full">
                    <ResponsivePicture
                      desktopSrc={service.imageDesktop}
                      mobileSrc={service.imageMobile}
                      alt={service.title}
                      aspectRatio="w-full h-full object-cover"
                    />
                  </div>
                </ArchitecturalFrame>
              </div>

            </div>
          </article>
        );
      })}
    </div>
  </section>

  <!-- Cross-Entity Prompt: Engineering & Permits -->
  <section class="py-16 bg-navy-950 text-white border-b border-navy-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-gradient-to-r from-navy-900 to-black p-8 sm:p-12 border border-steel-500/30 flex flex-col lg:flex-row items-center justify-between gap-8">
        <div class="space-y-3 max-w-2xl text-center lg:text-left">
          <Badge variant="consult">Structural &amp; Civil Engineering Practice</Badge>
          <h2 class="text-2xl sm:text-3xl font-display font-bold uppercase tracking-tight text-white">
            Need Structural Calculations or Canadian Municipal Building Permits?
          </h2>
          <p class="text-sm text-slate-300 font-sans leading-relaxed">
            Our sister entity <strong>Swift Consult Inc.</strong> provides licensed P.Eng structural calculations, Civil 3D site servicing, SWMM stormwater modeling, and municipal permit clearance in Canada and the United States.
          </p>
        </div>
        <div class="flex-shrink-0">
          <Button href="/consult/services" variant="primary" size="lg">
            Explore Swift Consult Engineering →
          </Button>
        </div>
      </div>
    </div>
  </section>
</Layout>
