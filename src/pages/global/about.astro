---
import Layout from '@/layouts/Layout.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import ArchitecturalFrame from '@/components/ui/ArchitecturalFrame.astro';
import Button from '@/components/ui/Button.astro';
import Badge from '@/components/ui/Badge.astro';
import ResponsivePicture from '@/components/ui/ResponsivePicture.astro';
import { GLOBAL_REGIONS } from '@/data/companyData';
---

<Layout
  title="About Swift Global Inc. | International Procurement & EPC Practice"
  description="Learn about Swift Global Inc., our global supply chain infrastructure, industrial facility modernization capabilities, and turnkey EPC delivery model across North America, the Middle East, and West Africa."
  currentEntity="global"
  activePath="/global/about"
>
  <!-- Page Header -->
  <section class="bg-black text-white py-16 lg:py-20 border-b border-navy-800 relative overflow-hidden">
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl space-y-4">
        <div class="flex items-center gap-2">
          <Badge variant="global">International Operations</Badge>
          <span class="font-mono text-xs text-amber-construction">Procurement &amp; EPC Contractor</span>
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-display font-extrabold uppercase tracking-tight text-white leading-tight">
          About Swift Global Inc.
        </h1>
        <p class="text-base sm:text-lg text-slate-300 font-sans leading-relaxed">
          Operating at the nexus of strategic equipment manufacturing, global logistics staging, and industrial construction, Swift Global Inc. delivers turnkey execution for high-consequence capital projects.
        </p>
      </div>
    </div>
  </section>

  <!-- Industrial Philosophy & Capabilities -->
  <section class="py-20 lg:py-24 bg-slate-950 text-white border-b border-navy-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <!-- Left: Copy -->
        <div class="lg:col-span-7 space-y-6">
          <div class="space-y-2">
            <span class="text-xs font-mono text-amber-construction uppercase tracking-architect">01 // Supply Chain Rigor</span>
            <h2 class="text-2xl sm:text-3xl font-display font-bold uppercase tracking-tight text-white">
              Sourcing Integrity &amp; Turnkey Construction Governance
            </h2>
            <div class="w-12 h-0.5 bg-amber-construction"></div>
          </div>

          <p class="text-sm sm:text-base text-slate-300 font-sans leading-relaxed">
            Swift Global Inc. addresses the most complex challenge in modern industrial construction: eliminating schedule drift and quality degradation in long-lead capital equipment. We maintain direct relationships with ISO 9001 and ASME-certified original equipment manufacturers (OEMs) worldwide.
          </p>

          <p class="text-sm sm:text-base text-slate-300 font-sans leading-relaxed">
            From preliminary technical bid leveling and Factory Acceptance Testing (FAT) to port staging, maritime chartering, and on-site EPC installation, our engineers provide complete transparency and contractual certainty.
          </p>

          <!-- Core Capability Pillars -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4 font-mono text-xs">
            <div class="p-4 bg-navy-950 border border-navy-800">
              <span class="text-amber-construction font-bold block mb-1">01 / VENDOR CONTROL</span>
              <p class="text-slate-300 font-sans text-xs">Exhaustive factory audits, mill test report (MTR) verification, and non-destructive testing (NDT) oversight.</p>
            </div>
            <div class="p-4 bg-navy-950 border border-navy-800">
              <span class="text-amber-construction font-bold block mb-1">02 / INCOTERMS 2020</span>
              <p class="text-slate-300 font-sans text-xs">Full customs clearance, heavy-lift ocean freight handling, and bonded port staging across key trade corridors.</p>
            </div>
          </div>
        </div>

        <!-- Right: Frame Image -->
        <div class="lg:col-span-5">
          <ArchitecturalFrame
            cut="bl"
            class="border-amber-500/30 bg-black"
            annotationStrip={{
              code: "ISO 9001 / ASME / FAT INSPECTED",
              location: "INTERNATIONAL SUPPLY CHAIN"
            }}
          >
            <div class="aspect-[4/3] w-full">
              <ResponsivePicture
                desktopSrc="/images/global-logistics.webp"
                mobileSrc="/images/global-logistics-mobile.webp"
                alt="Swift Global Supply Chain Staging"
                aspectRatio="w-full h-full object-cover"
              />
            </div>
          </ArchitecturalFrame>
        </div>

      </div>
    </div>
  </section>

  <!-- Global Hubs -->
  <section class="py-20 bg-black text-white border-b border-navy-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-12">
        <span class="text-xs font-mono text-amber-construction uppercase tracking-architect">02 // Operational Footprint</span>
        <h2 class="text-2xl sm:text-3xl font-display font-bold uppercase tracking-tight text-white mt-1">
          Strategic Procurement Hubs &amp; Corridors
        </h2>
        <div class="w-12 h-0.5 bg-amber-construction mt-2 mb-4"></div>
        <p class="text-sm text-slate-300 font-sans">
          Connecting major manufacturing epicenters with dynamic frontier markets across four strategic regions.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 font-mono text-xs">
        {GLOBAL_REGIONS.map((r) => (
          <div class="p-6 bg-navy-950 border border-navy-800 space-y-3">
            <div class="text-2xl">{r.flag}</div>
            <h3 class="font-display font-bold text-white text-base uppercase">{r.region}</h3>
            <p class="text-xs text-slate-300 font-sans leading-relaxed">{r.description}</p>
            <div class="pt-3 border-t border-navy-850">
              <span class="text-[10px] text-amber-construction block uppercase">Key Hubs:</span>
              <span class="text-white text-[11px]">{r.keyHubs.join(' • ')}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Sister Company Synergy -->
  <section class="py-20 bg-navy-950 text-white border-b border-navy-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-12">
        <span class="text-xs font-mono text-steel-400 uppercase tracking-architect">03 // Sister Entity Synergy</span>
        <h2 class="text-2xl sm:text-3xl font-display font-bold uppercase tracking-tight text-white mt-1">
          The Design &amp; Permitting Arm: Swift Consult Inc.
        </h2>
        <div class="w-12 h-0.5 bg-steel-400 mt-2 mb-4"></div>
        <p class="text-sm text-slate-300 font-sans">
          How Swift Global Inc. pairs with sister entity Swift Consult Inc. to offer turnkey concept-through-commissioning delivery.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="p-8 bg-black border border-amber-500/40 space-y-4">
          <div class="flex items-center justify-between pb-3 border-b border-navy-800 font-mono text-xs">
            <strong class="text-amber-construction uppercase">Swift Global Inc. (This Website)</strong>
            <span class="text-slate-400">Sourcing &amp; EPC</span>
          </div>
          <h3 class="text-xl font-display font-bold uppercase text-white">Execution &amp; Sourcing Engine</h3>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed font-sans">
            Specializing in international vendor prequalification, heavy machinery sourcing, FAT inspection protocols, and turnkey construction management across the globe.
          </p>
          <ul class="space-y-1.5 text-xs text-slate-300 font-mono" role="list">
            <li>✓ Heavy Equipment Sourcing &amp; FAT</li>
            <li>✓ Incoterms 2020 Maritime Logistics</li>
            <li>✓ Turnkey EPC Contract Administration</li>
          </ul>
        </div>

        <div class="p-8 bg-blueprint-bg text-navy-900 border border-slate-300 space-y-4">
          <div class="flex items-center justify-between pb-3 border-b border-slate-200 font-mono text-xs">
            <strong class="text-navy-900 uppercase">Swift Consult Inc. (Sister Entity)</strong>
            <span class="text-steel-600">Design &amp; Permitting</span>
          </div>
          <h3 class="text-xl font-display font-bold uppercase text-navy-900">Engineering &amp; Code Engine</h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-sans">
            Providing licensed P.Eng structural calculations, Civil 3D site servicing, SWMM stormwater modeling, and municipal permit clearance in Canada and the US.
          </p>
          <div class="pt-4">
            <Button href="/consult" variant="primary" size="sm">
              Visit Swift Consult Inc. Website →
            </Button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="py-16 bg-black text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
      <h2 class="text-2xl sm:text-3xl font-display font-bold uppercase tracking-tight text-white">
        Solicit an International Procurement Proposal
      </h2>
      <p class="text-sm text-slate-300 font-sans max-w-xl mx-auto">
        Speak with our procurement specialists to discuss equipment schedules, vendor audits, or turnkey EPC proposals.
      </p>
      <div>
        <Button href="/global/contact" variant="accent" size="lg">
          Submit Procurement RFP →
        </Button>
      </div>
    </div>
  </section>
</Layout>
