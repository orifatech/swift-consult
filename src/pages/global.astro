---
import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/sections/Hero.astro';
import SectorsSection from '@/components/sections/SectorsSection.astro';
import ServicesGrid from '@/components/sections/ServicesGrid.astro';
import GlobalFootprint from '@/components/sections/GlobalFootprint.astro';
import ProjectsPortfolio from '@/components/sections/ProjectsPortfolio.astro';
import ContactSection from '@/components/sections/ContactSection.astro';
import Button from '@/components/ui/Button.astro';
import Badge from '@/components/ui/Badge.astro';
---

<Layout
  title="Swift Global Inc. | International Procurement & Turnkey EPC Solutions"
  description="Swift Global Inc. delivers international heavy equipment procurement, technical vendor prequalification, industrial facility operations, and cross-border EPC management."
  currentEntity="global"
  activePath="/global"
  preloadImage="/images/global-logistics.webp"
  preloadImageMobile="/images/global-logistics-mobile.webp"
>
  <!-- Hero Section pre-configured for Swift Global -->
  <Hero entity="global" />

  <!-- Special Global Focus Strip -->
  <section class="py-12 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        
        <div class="p-6 bg-blueprint-bg border border-slate-300">
          <Badge variant="navy" size="sm" class="mb-3">CAPABILITY 01</Badge>
          <h3 class="font-display font-bold text-navy-900 text-lg uppercase">Heavy Equipment Procurement</h3>
          <p class="text-xs text-slate-600 mt-2 leading-relaxed">
            Direct global manufacturer relationships for certified structural steel, process pressure vessels, turbomachinery, and specialized bulk materials.
          </p>
        </div>

        <div class="p-6 bg-blueprint-bg border border-slate-300">
          <Badge variant="navy" size="sm" class="mb-3">CAPABILITY 02</Badge>
          <h3 class="font-display font-bold text-navy-900 text-lg uppercase">Vendor Prequalification &amp; FAT</h3>
          <p class="text-xs text-slate-600 mt-2 leading-relaxed">
            On-site quality inspections, Factory Acceptance Testing (FAT), technical bid leveling, and third-party metallurgical verifications.
          </p>
        </div>

        <div class="p-6 bg-blueprint-bg border border-slate-300">
          <Badge variant="navy" size="sm" class="mb-3">CAPABILITY 03</Badge>
          <h3 class="font-display font-bold text-navy-900 text-lg uppercase">Turnkey EPC Project Delivery</h3>
          <p class="text-xs text-slate-600 mt-2 leading-relaxed">
            Multi-model construction execution (EPC, Design-Build, CM at-Risk) with international logistics staging across Middle East and West African ports.
          </p>
        </div>

      </div>

      <!-- Sister Entity Bridge Notice -->
      <div class="mt-8 p-4 bg-navy-900 text-white flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-3 text-xs font-mono">
          <span class="text-amber-construction">⚡</span>
          <span>Require structural calculations or North American municipal permits? Explore sister entity <strong>Swift Consult Inc.</strong></span>
        </div>
        <a
          href="/consult"
          class="px-3 py-1.5 bg-steel-500 hover:bg-steel-600 text-white font-mono text-xs uppercase tracking-wider transition-colors whitespace-nowrap"
        >
          View Swift Consult →
        </a>
      </div>
    </div>
  </section>

  <!-- Global Sectors Focus -->
  <SectorsSection
    eyebrow="Industrial & Infrastructure Scope"
    title="Heavy Industrial &amp; Logistics Operations"
    subtitle="Executing major equipment installations, process plant modernizations, and deepwater marine terminal staging."
  />

  <!-- Global Reach Map & Footprint -->
  <GlobalFootprint />

  <!-- Filtered Projects by Swift Global -->
  <ProjectsPortfolio
    entityFilter="global"
    limit={3}
  />

  <!-- Global Contact Form -->
  <ContactSection defaultEntity="global" />
</Layout>
