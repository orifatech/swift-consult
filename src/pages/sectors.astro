---
import Layout from '@/layouts/Layout.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import ArchitecturalFrame from '@/components/ui/ArchitecturalFrame.astro';
import ResponsivePicture from '@/components/ui/ResponsivePicture.astro';
import Button from '@/components/ui/Button.astro';
import Badge from '@/components/ui/Badge.astro';
import { SECTORS } from '@/data/companyData';
---

<Layout
  title="Sectors & Operations | Commercial, Industrial & Residential"
  description="Explore Swift Consult and Swift Global's engineering and EPC operations across Commercial Buildings, Industrial Facilities, and Residential Developments."
  currentEntity="group"
  activePath="/sectors"
  preloadImage="/images/commercial-tower.webp"
>
  <!-- Page Header Banner -->
  <section class="bg-navy-950 text-white py-16 sm:py-20 border-b border-navy-800 relative overflow-hidden">
    <div class="absolute inset-0 bg-blueprint-grid-dark opacity-60 pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      <div class="max-w-3xl">
        <div class="font-mono text-xs text-amber-construction uppercase tracking-architect mb-2">
          02 // Sector Capabilities &amp; Operations
        </div>
        <h1 class="text-3xl sm:text-5xl font-display font-bold uppercase tracking-tight text-white leading-tight">
          Targeted Industry Solutions Across Three Core Sectors.
        </h1>
        <div class="w-16 h-0.5 mt-4 mb-5 bg-steel-500" aria-hidden="true"></div>
        <p class="text-base sm:text-lg text-slate-300 font-sans leading-relaxed">
          From high-density urban commercial towers to complex international industrial plants and boutique residential communities, explore how our technical engine solves complex problems.
        </p>
      </div>
    </div>
  </section>

  <!-- Detailed Sector Breakdowns -->
  <div class="py-16 sm:py-20 space-y-20 bg-white">
    {SECTORS.map((sector, index) => (
      <section id={sector.id} class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 scroll-mt-28" aria-labelledby={`sector-title-${sector.id}`}>
        
        <div class={`grid grid-cols-1 lg:grid-cols-12 gap-12 items-center ${index % 2 === 1 ? 'lg:flex-row-reverse' : ''}`}>
          
          <!-- Image Column -->
          <div class={`lg:col-span-6 ${index % 2 === 1 ? 'lg:order-2' : 'lg:order-1'}`}>
            <ArchitecturalFrame
              specCode={`SECTOR CODE: SEC-0${index + 1}`}
              coordLabel={sector.leadEntity}
              chamfer={index % 2 === 0 ? 'tr' : 'bl'}
              class="border-slate-300"
            >
              <div class="aspect-[16/10] w-full">
                <ResponsivePicture
                  desktopSrc={sector.imageDesktop}
                  mobileSrc={sector.imageMobile}
                  alt={sector.title}
                  width={1400}
                  height={875}
                  loading={index === 0 ? 'eager' : 'lazy'}
                  class="w-full h-full object-cover"
                />
              </div>
            </ArchitecturalFrame>
          </div>

          <!-- Content Column -->
          <div class={`lg:col-span-6 space-y-6 ${index % 2 === 1 ? 'lg:order-1' : 'lg:order-2'}`}>
            <div class="flex items-center gap-2">
              <span class="font-mono text-xs font-bold text-amber-construction">SEC 0{index + 1} //</span>
              <Badge variant={sector.leadEntity.includes('Consult') ? 'steel' : sector.leadEntity.includes('Global') ? 'navy' : 'gold'}>
                Lead: {sector.leadEntity}
              </Badge>
            </div>

            <h2 id={`sector-title-${sector.id}`} class="text-2xl sm:text-3xl font-display font-bold uppercase tracking-tight text-navy-900 leading-snug">
              {sector.title}
            </h2>

            <p class="text-sm sm:text-base text-slate-600 font-sans leading-relaxed">
              {sector.summary}
            </p>

            <!-- Detailed Bullet Points from PDF -->
            <div class="p-5 bg-blueprint-bg border border-slate-300 space-y-3">
              <div class="text-[11px] font-mono uppercase text-slate-500 tracking-wider">
                Key Offerings &amp; Core Activities:
              </div>
              <ul class="space-y-2 text-xs sm:text-sm text-slate-700" role="list">
                {sector.bulletPoints.map((bullet) => (
                  <li class="flex items-start gap-2.5">
                    <span class="text-steel-600 font-mono text-base leading-none select-none mt-0.5" aria-hidden="true">■</span>
                    <span class="font-medium">{bullet}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Sector Metrics Strip -->
            <div class="grid grid-cols-2 gap-3 font-mono">
              {sector.stats.map((stat) => (
                <div class="p-3 bg-slate-50 border border-slate-200">
                  <span class="block text-[10px] text-slate-500 uppercase">{stat.label}</span>
                  <span class="block text-base font-bold text-navy-900">{stat.value}</span>
                </div>
              ))}
            </div>

            <!-- Sector Specific CTA -->
            <div class="pt-2">
              <Button href="/contact" variant="primary" size="md">
                Inquire Regarding {sector.title.split(' ')[0]} Projects →
              </Button>
            </div>

          </div>

        </div>

        {index < SECTORS.length - 1 && (
          <div class="w-full h-px bg-slate-200 mt-20" aria-hidden="true"></div>
        )}
      </section>
    ))}
  </div>
</Layout>
