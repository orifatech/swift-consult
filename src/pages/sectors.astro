---
import Layout from '@/layouts/Layout.astro';
import ArchitecturalFrame from '@/components/ui/ArchitecturalFrame.astro';
import Button from '@/components/ui/Button.astro';
import Badge from '@/components/ui/Badge.astro';
import ResponsivePicture from '@/components/ui/ResponsivePicture.astro';
import { SECTORS } from '@/data/companyData';
---

<Layout
  title="Practice Sectors & Building Typologies | Swift Consult Inc."
  description="Explore the sectors served by Swift Consult Inc., including commercial high-rise towers, master-planned residential subdivisions, and industrial warehouse structures."
  activePath="/sectors"
>
  <!-- Page Header -->
  <section class="bg-navy-950 text-white py-16 lg:py-24 border-b border-navy-850 relative overflow-hidden">
    <div class="absolute inset-0 bg-blueprint-grid-dark opacity-60 pointer-events-none" aria-hidden="true"></div>
    <div class="relative max-w-7xl mx-auto px-6 md:px-10 lg:px-12">
      <div class="max-w-3xl space-y-4">
        <div class="flex items-center gap-2">
          <Badge variant="steel">Sectors &amp; Typologies</Badge>
        </div>
        <h1 class="text-3xl sm:text-5xl font-display font-extrabold uppercase tracking-tight text-white leading-tight">
          Sectors &amp; Practice Areas
        </h1>
        <p class="text-base sm:text-lg text-slate-300 font-sans leading-relaxed">
          From high-density urban commercial towers to master-planned residential communities and industrial logistics depots, Swift Consult Inc. provides the engineering rigour required to deliver landmark properties.
        </p>
      </div>
    </div>
  </section>

  <!-- Sectors List -->
  <section class="py-20 lg:py-28 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-6 md:px-10 lg:px-12 space-y-24">
      {SECTORS.map((sector, index) => {
        const isReversed = index % 2 !== 0;
        return (
          <article id={sector.id} class="scroll-mt-28">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
              
              <div class={`space-y-4 ${isReversed ? 'lg:order-2' : 'lg:order-1'}`}>
                <h2 class="text-2xl sm:text-3xl font-display font-bold uppercase tracking-tight text-navy-900">
                  {sector.title}
                </h2>

                <p class="text-[15px] sm:text-[17px] text-slate-600 font-sans leading-relaxed">
                  {sector.summary}
                </p>

                <div class="space-y-3 pt-2">
                  <div class="text-xs font-mono uppercase font-bold text-slate-500 tracking-wider">Sector Offerings &amp; Engineering Scope:</div>
                  <ul class="space-y-2 text-xs sm:text-base text-slate-700" role="list">
                    {sector.bulletPoints.map((point) => (
                      <li class="flex items-start gap-3">
                        <span class="text-steel-600 font-bold">✓</span>
                        <span>{point}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <div class="pt-4 border-t border-slate-200 flex flex-wrap gap-4 font-mono text-xs">
                  {sector.stats.map((s) => (
                    <div class="p-3 rounded-md bg-white border border-slate-200 shadow-sm">
                      <span class="text-slate-500 block text-[10px] uppercase">{s.label}</span>
                      <strong class="text-navy-900">{s.value}</strong>
                    </div>
                  ))}
                </div>

                <div class="pt-4">
                  <Button href="/contact" variant="primary" size="md">
                    Discuss With Our Engineers →
                  </Button>
                </div>
              </div>

              <div class={`${isReversed ? 'lg:order-1' : 'lg:order-2'}`}>
                <ArchitecturalFrame
                  specCode={sector.stats[0]?.value || 'SECTOR DELIVERABLE'}
                  coordLabel="TORONTO PRACTICE"
                >
                  <div class="aspect-[4/3] w-full">
                    <ResponsivePicture
                      desktopSrc={sector.imageDesktop}
                      mobileSrc={sector.imageMobile}
                      alt={sector.title}
                      class="w-full h-full object-cover"
                    />
                  </div>
                </ArchitecturalFrame>
              </div>

            </div>
          </article>
        );
      })}
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 bg-slate-50 text-navy-900 text-center">
    <div class="max-w-4xl mx-auto px-6 md:px-10 lg:px-12 space-y-6">
      <h2 class="text-3xl sm:text-4xl font-display font-extrabold uppercase text-navy-900">
        Initiate Your Project Feasibility Review
      </h2>
      <p class="text-base md:text-lg text-slate-600 max-w-xl mx-auto font-sans">
        Our engineers will analyze your site constraints, architectural concepts, and municipal jurisdiction.
      </p>
      <div class="pt-4">
        <Button href="/contact" variant="primary" size="lg">
          Request Engineering Proposal →
        </Button>
      </div>
    </div>
  </section>
</Layout>
