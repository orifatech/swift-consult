---
import Layout from '@/layouts/Layout.astro';
import ArchitecturalFrame from '@/components/ui/ArchitecturalFrame.astro';
import Button from '@/components/ui/Button.astro';
import Badge from '@/components/ui/Badge.astro';
import ResponsivePicture from '@/components/ui/ResponsivePicture.astro';
import { SERVICES } from '@/data/companyData';
---

<Layout
  title="Engineering Services & Technical Disciplines | Swift Consult Inc."
  description="Explore the technical engineering disciplines offered by Swift Consult Inc.: Structural Engineering & Design, Civil & Site Infrastructure, Permitting & Municipal Approvals, BIM Modeling, and Construction Administration."
  activePath="/services"
>
  <!-- Page Header -->
  <section class="bg-navy-950 text-white py-16 lg:py-24 border-b border-navy-850 relative overflow-hidden">
    <div class="absolute inset-0 bg-blueprint-grid-dark opacity-60 pointer-events-none" aria-hidden="true"></div>
    <div class="relative max-w-7xl mx-auto px-6 md:px-10 lg:px-12">
      <div class="max-w-3xl space-y-4">
        <div class="flex items-center gap-2">
          <Badge variant="steel">Engineering Matrix</Badge>
          <span class="font-mono text-xs text-steel-300">P.Eng Oversight • OBC / NBC / IBC</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-display font-extrabold uppercase tracking-tight text-white leading-tight">
          Consulting Engineering Disciplines
        </h1>
        <p class="text-base sm:text-lg text-slate-300 font-sans leading-relaxed">
          From advanced finite element structural modeling to subdivision stormwater hydraulics and municipal approvals, Swift Consult Inc. provides the engineering foundation for complex North American developments.
        </p>
      </div>
    </div>
  </section>

  <!-- Deep-Dive Services List -->
  <section class="py-20 lg:py-28 bg-white">
    <div class="max-w-7xl mx-auto px-6 md:px-10 lg:px-12 space-y-24">
      {SERVICES.map((service, index) => {
        const isReversed = index % 2 !== 0;
        return (
          <article id={`service-${service.number}`} class="scroll-mt-28">
            <div class={`grid grid-cols-1 lg:grid-cols-2 gap-10 ${isReversed ? 'lg:flex-row-reverse' : ''}`}>
              
              <!-- Content -->
              <div class={`space-y-4 ${isReversed ? 'lg:order-2' : 'lg:order-1'}`}>
                
                  <h2 class="text-2xl sm:text-3xl font-display font-bold uppercase tracking-tight text-navy-900">
                  {service.title}
                </h2>
                <p class="text-[15px] sm:text-[17px] text-slate-600 font-sans leading-relaxed">
                  {service.shortDesc}
                </p>

                <div class="space-y-3 pt-2">
                  <div class="text-xs font-mono font-bold uppercase text-slate-500 tracking-wider">Engineering Capabilities &amp; Deliverables:</div>
                  <ul class="space-y-3 text-xs sm:text-base text-slate-700" role="list">
                    {service.features.map((feature) => (
                      <li class="flex items-start gap-2.5">
                        <span class="text-steel-600 font-bold">✓</span>
                        <span>{feature}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <div class="flex flex-wrap gap-4 font-mono text-xs pt-4">
                  {service.keySpecs.map((spec) => (
                    <div class="p-3 rounded-md bg-white border border-slate-200 shadow-sm">
                      <span class="text-slate-500 block text-[10px] uppercase">{spec.label}</span>
                      <strong class="text-navy-900">{spec.value}</strong>
                    </div>
                  ))}
                </div>

                <div class="pt-2">
                  <Button href="/contact" variant="primary" size="md">
                    Inquire About {service.title} →
                  </Button>
                </div>
              </div>

              <!-- Media Frame -->
              <div class={`${isReversed ? 'lg:order-1' : 'lg:order-2'}`}>
                <ArchitecturalFrame
                  specCode={service.keySpecs[0]?.value || 'OBC / NBC'}
                  coordLabel="TORONTO PRACTICE"
                >
                  <div class="aspect-[4/3] w-full">
                    <ResponsivePicture
                      desktopSrc={service.imageDesktop}
                      mobileSrc={service.imageMobile}
                      alt={service.title}
                      class="w-full h-full object-cover"
                    />
                  </div>
                </ArchitecturalFrame>
              </div>

            </div>
          </article>
        );
      })}
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 bg-slate-50 text-navy-900 text-center">
    <div class="max-w-4xl mx-auto px-6 md:px-10 lg:px-12 space-y-6">
      <h2 class="text-3xl sm:text-4xl font-display font-extrabold uppercase text-navy-900">
        Require Stamped Engineering Calculations?
      </h2>
      <p class="text-base md:text-lg text-slate-600 max-w-xl mx-auto font-sans">
        Connect with our engineering principals to discuss your structural or civil scope.
      </p>
      <div class="pt-4">
        <Button href="/contact" variant="primary" size="lg">
          Request Engineering Proposal →
        </Button>
      </div>
    </div>
  </section>
</Layout>
