---
import Layout from '@/layouts/Layout.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Button from '@/components/ui/Button.astro';
import Badge from '@/components/ui/Badge.astro';
import ResponsivePicture from '@/components/ui/ResponsivePicture.astro';
import ArchitecturalFrame from '@/components/ui/ArchitecturalFrame.astro';
import { SERVICES } from '@/data/companyData';
---

<Layout
  title="The Technical Engine | 5 Core Engineering Disciplines"
  description="Detailed specifications for Swift Consult and Swift Global's 5 core disciplines: Structural Engineering, Civil & Site Development, Permitting & Approvals, Engineering Procurement, and Construction Management."
  currentEntity="group"
  activePath="/services"
  preloadImage="/images/structural-engineering.webp"
>
  <!-- Page Header Banner -->
  <section class="bg-navy-950 text-white py-16 sm:py-20 border-b border-navy-800 relative overflow-hidden">
    <div class="absolute inset-0 bg-blueprint-grid-dark opacity-60 pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      <div class="max-w-3xl">
        <div class="font-mono text-xs text-amber-construction uppercase tracking-architect mb-2">
          03 // The Technical Engine
        </div>
        <h1 class="text-3xl sm:text-5xl font-display font-bold uppercase tracking-tight text-white leading-tight">
          Five Multidisciplinary Disciplines. Flawless Technical Delivery.
        </h1>
        <div class="w-16 h-0.5 mt-4 mb-5 bg-steel-500" aria-hidden="true"></div>
        <p class="text-base sm:text-lg text-slate-300 font-sans leading-relaxed">
          Detailed sub-pages and technical specifications for each of our five core engineering, regulatory, procurement, and management practices.
        </p>
      </div>
    </div>
  </section>

  <!-- Quick Disciplines Anchor Navigation Strip -->
  <div class="sticky top-20 z-40 bg-white border-b border-slate-200 py-3 shadow-none overflow-x-auto">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center gap-2">
      <span class="text-[10px] font-mono uppercase text-slate-400 mr-2 whitespace-nowrap">Jump to Discipline:</span>
      {SERVICES.map((s) => (
        <a
          href={`#service-${s.number}`}
          class="px-3 py-1.5 bg-slate-100 hover:bg-navy-900 hover:text-white font-mono text-xs uppercase tracking-wider text-slate-700 transition-colors whitespace-nowrap border border-slate-200"
        >
          {s.number}. {s.title.split(' ')[0]}
        </a>
      ))}
    </div>
  </div>

  <!-- 5 Disciplines Detailed Breakdown -->
  <div class="py-16 sm:py-20 space-y-24 bg-blueprint-bg">
    {SERVICES.map((service, index) => (
      <section
        id={`service-${service.number}`}
        class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 scroll-mt-36"
        aria-labelledby={`heading-service-${service.number}`}
      >
        <div class="bg-white border border-slate-300 p-8 sm:p-10 lg:p-12">
          
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
            
            <!-- Left Info Area -->
            <div class="lg:col-span-7 space-y-6">
              
              <!-- Discipline Header -->
              <div class="flex items-center justify-between pb-4 border-b border-slate-200 font-mono">
                <div class="flex items-center gap-3">
                  <span class="text-3xl font-display font-extrabold text-navy-900">
                    {service.number} //
                  </span>
                  <Badge variant={service.entityRole.includes('Consult') ? 'steel' : service.entityRole.includes('Global') ? 'navy' : 'gold'}>
                    Competency: {service.entityRole}
                  </Badge>
                </div>
                <span class="text-xs text-slate-400 uppercase hidden sm:inline">Discipline Spec</span>
              </div>

              <h2 id={`heading-service-${service.number}`} class="text-2xl sm:text-3xl font-display font-bold uppercase tracking-tight text-navy-900 leading-snug">
                {service.title}
              </h2>

              <p class="text-sm sm:text-base text-slate-600 font-sans leading-relaxed">
                {service.shortDesc}
              </p>

              <!-- Detailed Capabilities Matrix from PDF -->
              <div class="p-6 bg-slate-50 border border-slate-200 space-y-4">
                <div class="text-xs font-mono font-bold uppercase tracking-wider text-navy-900">
                  Key Offerings &amp; Engineering Features:
                </div>
                <ul class="space-y-2.5 text-xs sm:text-sm text-slate-700" role="list">
                  {service.features.map((feat) => (
                    <li class="flex items-start gap-3">
                      <span class="text-steel-600 font-mono text-sm leading-none mt-0.5 select-none" aria-hidden="true">✔</span>
                      <span class="font-medium">{feat}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Technical Specifications Grid -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 font-mono">
                {service.keySpecs.map((spec) => (
                  <div class="p-3 bg-blueprint-bg border border-slate-200">
                    <span class="block text-[10px] text-slate-500 uppercase">{spec.label}</span>
                    <strong class="block text-xs font-semibold text-navy-900">{spec.value}</strong>
                  </div>
                ))}
              </div>

              <!-- Action Link -->
              <div class="pt-2 flex items-center gap-4">
                <Button href="/contact" variant="primary" size="md">
                  Request {service.title.split(' ')[0]} Proposal →
                </Button>
              </div>

            </div>

            <!-- Right Image Frame -->
            <div class="lg:col-span-5">
              <ArchitecturalFrame
                specCode={`DISCIPLINE: ${service.number}`}
                coordLabel={service.entityRole}
                chamfer="tr"
                class="border-slate-300"
              >
                <div class="aspect-[4/3] w-full">
                  <ResponsivePicture
                    desktopSrc={service.imageDesktop}
                    mobileSrc={service.imageMobile}
                    alt={service.title}
                    width={1200}
                    height={900}
                    loading={index === 0 ? 'eager' : 'lazy'}
                    class="w-full h-full object-cover"
                  />
                </div>
              </ArchitecturalFrame>

              <!-- Blueprint Context Note -->
              <div class="mt-4 p-4 bg-navy-950 text-white border border-navy-800 font-mono text-xs">
                <div class="text-[10px] text-amber-construction uppercase font-semibold">Standard Operating Procedures</div>
                <p class="text-slate-300 font-sans text-xs mt-1">
                  All engineering design packages are stamped by certified Canadian and US professional engineers (P.Eng / PE) in accordance with local jurisdictional statutory regulations.
                </p>
              </div>
            </div>

          </div>

        </div>
      </section>
    ))}
  </div>
</Layout>
